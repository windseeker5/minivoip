package pages

import (
	"strconv"
	"time"

	"minivoip/components/badge"
	"minivoip/components/icon"
	"minivoip/store"
)

// when shows a stored UTC time in the server's time zone: "Oct 21, 8:14 PM".
func when(utc string) string {
	t, err := time.ParseInLocation(time.DateTime, utc, time.UTC)
	if err != nil {
		return utc
	}
	return t.Local().Format("Jan 2, 3:04 PM")
}

func length(v store.Voicemail) string {
	s := v.Seconds()
	return strconv.FormatInt(s/60, 10) + ":" + pad(s%60)
}

func pad(n int64) string {
	if n < 10 {
		return "0" + strconv.FormatInt(n, 10)
	}
	return strconv.FormatInt(n, 10)
}

templ VoicemailPage(email string, list []store.Voicemail) {
	@dashShell("Voicemail", email, "/dashboard/voicemail") {
		<h1 class="text-3xl font-bold tracking-tight">Voicemail</h1>
		<p class="mt-2 text-muted-foreground">Messages callers left when nobody answered, or when they picked a voicemail choice.</p>
		<div class="mt-8">
			@VoicemailList(list, "/dashboard/voicemail")
		</div>
		<script src="/assets/js/voicemail.js" defer></script>
	}
}

// VoicemailList is shared by the dashboard and the phone app. back is where
// deleting returns to. voicemail.js marks a message played.
templ VoicemailList(list []store.Voicemail, back string) {
	<div data-voicemails>
		if len(list) == 0 {
			<div class="flex flex-col items-center gap-2 rounded-2xl border border-dashed px-6 py-10 text-center">
				@icon.Voicemail(icon.Props{Class: "size-8 text-muted-foreground"})
				<p class="font-medium">No messages yet</p>
				<p class="max-w-xs text-sm text-muted-foreground">When a caller leaves a message, it shows up here and in your phone app.</p>
			</div>
		} else {
			<ul class="flex flex-col gap-3">
				for _, v := range list {
					<li class="flex flex-col gap-3 rounded-2xl border bg-background p-4" data-voicemail={ strconv.FormatInt(v.ID, 10) }>
						<div class="flex items-start justify-between gap-3">
							<div class="flex flex-col">
								<span class="flex items-center gap-2 font-semibold">
									Website caller
									if !v.Listened {
										@badge.Badge(badge.Props{Attributes: templ.Attributes{"data-new": ""}}) {
											New
										}
									}
								</span>
								<span class="text-sm text-muted-foreground tabular-nums">
									{ when(v.CreatedAt) } · { length(v) }
									if v.Option != "" {
										· { v.Option }
									}
								</span>
							</div>
							<form method="post" action={ templ.SafeURL("/voicemail/" + strconv.FormatInt(v.ID, 10) + "/delete") }>
								<input type="hidden" name="back" value={ back }/>
								<button type="submit" class="flex size-9 items-center justify-center rounded-lg text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Delete this message">
									@icon.Trash2(icon.Props{Class: "size-4"})
								</button>
							</form>
						</div>
						<audio controls preload="none" class="w-full" src={ "/voicemail/" + strconv.FormatInt(v.ID, 10) + "/audio" }></audio>
					</li>
				}
			</ul>
		}
	</div>
}
