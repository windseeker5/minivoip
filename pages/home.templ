package pages

import (
	"minivoip/components/badge"
	"minivoip/components/button"
	"minivoip/components/icon"
	"minivoip/layouts"
)

// The words come from docs/landing-copy.md; change them there first.

type feature struct {
	Icon  func(...icon.Props) templ.Component
	Title string
	Text  string
}

var features = []feature{
	{icon.PhoneIncoming, "Answers every call", "Your receptionist greets callers in your own voice, day or night."},
	{icon.Split, "Sends each call to the right place", "The right person, your booking page, your price list or your opening hours. You decide what each choice does."},
	{icon.Smartphone, "Rings your cell", "Only when the call is really for you. It uses the phone you already have, with the same number."},
	{icon.Voicemail, "Takes messages", "Callers leave a voicemail and you get an alert on your phone to play it."},
	{icon.Clock, "Knows your hours", "After closing time, callers hear your after-hours message and leave a message."},
	{icon.Users, "Rings your whole team", "Add a partner's phone or your laptop. They all ring, and the first person free takes the call."},
	{icon.Globe, "Works from your website", "One Call button on your site, or a link and QR code for Google Maps, Facebook or your front door."},
	{icon.Lock, "Keeps your number private", "Callers never see your cell number, and calls are never recorded."},
	{icon.PiggyBank, "No phone line to pay", "$30 a year per line, after the free beta. No per-minute charges."},
}

// aiFeature is planned, not built: it must stay labelled "Coming soon".
var aiFeature = feature{icon.Sparkles, "AI receptionist", "Answers common questions for you, like your hours, prices and directions, and sums up your messages."}


type step struct {
	Title string
	Text  string
}

var steps = []step{
	{"Record your greeting", "Say hello and set the choices: press 1 for bookings, 2 to talk to you. Record it from your browser."},
	{"Install the app on your phone", "Open a link on your phone and add it to your home screen. Your phone number stays the same."},
	{"Add the button to your site", "Paste one line into your website. Can't edit your site? Share your call link or a QR code."},
}

type faq struct {
	Q string
	A string
}

var faqs = []faq{
	{"Can people call me from a regular phone?", "Not yet. Calls come from your website, your call link or a QR code. A real phone number is planned as an add-on."},
	{"Will my iPhone ring like a normal call?", "You get a notification with a sound, and you answer by tapping it. Apple doesn't let web apps show a full ringing screen. Android phones and computers keep ringing until you answer."},
	{"Does the caller need to install anything?", "No. They click the button and talk from their browser, after allowing the microphone."},
	{"What if I miss the call?", "After 30 seconds the caller can leave a voicemail. You get a notification and play it in the app."},
	{"I can't edit my website. Can I still use it?", "Yes. Put your call link on your Google Maps listing, your Facebook page, your email signature, or print it as a QR code for your door."},
}

var included = []string{
	"Your receptionist: greeting, choices and call routing",
	"Unlimited calls, no per-minute charges",
	"Voicemail with notifications",
	"Call link and QR code",
	"As many phones as you like",
}

templ Home() {
	@layouts.Base("minivoip: a virtual receptionist for your website that rings your cell", "Your website's receptionist answers every call in your voice, sends it to the right place and rings your cell when it's for you. No phone line needed. Free while in beta.") {
		@siteNav()
		<main>
			@hero()
			@demo()
			@featureGrid()
			@howItWorks()
			@pricing()
			@faqList()
			@finalCall()
		</main>
		@siteFooter()
		<script src="/assets/js/landing.js" defer></script>
	}
}

// brand is the mini-family logo (same bars and wordmark as minipass and
// minicrm), one artwork per theme. Only the height is set.
templ brand() {
	<a href="/" class="flex shrink-0 items-center" aria-label="minivoip home">
		<img src="/assets/brand/logo-minivoip.svg" alt="minivoip" width="132" height="24" class="h-6 w-auto dark:hidden"/>
		<img src="/assets/brand/logo-minivoip-dark.svg" alt="minivoip" width="132" height="24" class="hidden h-6 w-auto dark:block"/>
	</a>
}

templ siteNav() {
	<nav class="sticky top-0 z-50 border-b bg-background/95">
		<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
			@brand()
			<div class="flex items-center gap-1 sm:gap-2">
				<div class="hidden items-center gap-1 md:flex">
					@button.Button(button.Props{Href: "#features", Variant: button.VariantGhost, Size: button.SizeSm}) {
						Features
					}
					@button.Button(button.Props{Href: "#how", Variant: button.VariantGhost, Size: button.SizeSm}) {
						How it works
					}
					@button.Button(button.Props{Href: "#pricing", Variant: button.VariantGhost, Size: button.SizeSm}) {
						Pricing
					}
					@button.Button(button.Props{Href: "#faq", Variant: button.VariantGhost, Size: button.SizeSm}) {
						Questions
					}
				</div>
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Attributes: templ.Attributes{"data-theme-toggle": "", "aria-label": "Switch light or dark mode"}}) {
					<span class="hidden dark:block">
						@icon.Sun()
					</span>
					<span class="block dark:hidden">
						@icon.Moon()
					</span>
				}
				@button.Button(button.Props{Href: "/signup", Size: button.SizeSm}) {
					Get my free line
				}
			</div>
		</div>
	</nav>
}

templ hero() {
	<section class="mx-auto max-w-4xl px-4 pt-20 pb-14 text-center sm:pt-28">
		<h1 class="text-4xl font-bold tracking-tight text-balance sm:text-6xl">
			Your website's receptionist answers every call and sends it to your cell.
		</h1>
		<p class="mx-auto mt-6 max-w-2xl text-lg text-pretty text-muted-foreground">
			Visitors click Call on your website. Your receptionist greets them in your voice, sends each call to the right person, the right page or voicemail, and rings your cell only when it's for you. No phone line needed.
		</p>
		<div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
			@button.Button(button.Props{Href: "/signup", Size: button.SizeLg, Class: "h-11 px-6 text-base"}) {
				Get my free line
			}
			@button.Button(button.Props{Href: "#demo", Variant: button.VariantOutline, Size: button.SizeLg, Class: "h-11 px-6 text-base"}) {
				@icon.Play()
				Try the demo call
			}
		</div>
		<p class="mt-4 text-sm text-muted-foreground">Free while in beta. No card required.</p>
	</section>
}

// demo is a fake call: landing.js walks it through its states. Nothing rings
// and nothing is recorded.
templ demo() {
	<section id="demo" class="mx-auto max-w-5xl px-4 pb-24">
		<div class="demo grid overflow-hidden rounded-2xl border bg-card shadow-[0_24px_60px_-30px_rgb(0_0_0/0.35)] md:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]" data-demo data-state="idle">
			<div class="flex flex-col border-b md:border-r md:border-b-0">
				<div class="flex items-center gap-2 border-b bg-muted/50 px-4 py-2.5 text-xs text-muted-foreground">
					<span class="flex gap-1.5" aria-hidden="true">
						<span class="size-2.5 rounded-full bg-border"></span>
						<span class="size-2.5 rounded-full bg-border"></span>
						<span class="size-2.5 rounded-full bg-border"></span>
					</span>
					<span class="ml-2 truncate rounded-md bg-background px-2 py-0.5">joesbnb.example</span>
					<span class="ml-auto">What your visitor sees</span>
				</div>
				<div class="flex min-h-[380px] flex-1 flex-col items-center justify-center gap-5 p-8 text-center" aria-live="polite">
					<div data-when="idle" class="flex flex-col items-center gap-5">
						<p class="text-sm text-muted-foreground">Joe's B&amp;B, a sample business</p>
						<button type="button" data-action="call" class="demo-call flex size-28 flex-col items-center justify-center gap-1.5 rounded-full bg-primary text-sm font-semibold text-primary-foreground transition-transform hover:scale-[1.03] focus-visible:ring-4 focus-visible:ring-ring/50 focus-visible:outline-none active:scale-[0.98]">
							@icon.Phone(icon.Props{Class: "size-6"})
							Call us
						</button>
						<p class="text-sm text-muted-foreground">Press it. Nobody's phone will ring.</p>
					</div>
					<div data-when="greeting" hidden class="flex flex-col items-center gap-5">
						@voiceBars()
						<p class="max-w-sm text-lg text-balance">"Hi, you've reached Joe's B&amp;B. Press 1 for bookings, 2 to talk to Joe, or 3 for our hours."</p>
						<p class="text-sm text-muted-foreground">Joe's greeting, in Joe's voice</p>
					</div>
					<div data-when="menu" hidden class="flex w-full max-w-xs flex-col gap-2.5">
						<p class="mb-1 text-sm text-muted-foreground">Choose an option</p>
						@menuKey("1", "Bookings", "opens the booking page", "book")
						@menuKey("2", "Talk to Joe", "rings Joe's phones", "ring")
						@menuKey("3", "Opening hours", "plays a message", "hours")
					</div>
					<div data-when="book" hidden class="flex flex-col items-center gap-3">
						<span class="flex size-12 items-center justify-center rounded-full bg-muted">
							@icon.Globe(icon.Props{Class: "size-6"})
						</span>
						<p class="text-lg font-medium">Opening joesbnb.example/booking</p>
						<p class="max-w-xs text-sm text-muted-foreground">Option 1 sends callers to a page of Joe's website instead of a phone. The call ends there.</p>
					</div>
					<div data-when="hours" hidden class="flex flex-col items-center gap-4">
						@voiceBars()
						<p class="max-w-sm text-lg text-balance">"We're open every day from 8 a.m. to 8 p.m. Thanks for calling!"</p>
						<p class="text-sm text-muted-foreground">Option 3 plays a message, then hangs up.</p>
					</div>
					<div data-when="ringing" hidden class="flex flex-col items-center gap-4">
						<span class="demo-ring flex size-16 items-center justify-center rounded-full bg-emerald-600 text-white">
							@icon.PhoneCall(icon.Props{Class: "size-7"})
						</span>
						<p class="text-lg font-medium">Ringing Joe's phones…</p>
						<p class="text-sm text-muted-foreground tabular-nums"><span data-ring-count>0</span> s</p>
					</div>
					<div data-when="voicemail" hidden class="flex flex-col items-center gap-4">
						<p class="max-w-sm text-lg text-balance">"Joe can't answer right now. Leave a message after the tone."</p>
						<button type="button" data-action="record" class="inline-flex h-11 items-center gap-2 rounded-lg bg-red-600 px-5 text-sm font-semibold text-white hover:bg-red-700 focus-visible:ring-4 focus-visible:ring-red-600/30 focus-visible:outline-none">
							@icon.Mic(icon.Props{Class: "size-4"})
							Record a message
						</button>
						<p class="text-sm text-muted-foreground">Nothing is really recorded.</p>
					</div>
					<div data-when="recording" hidden class="flex flex-col items-center gap-4">
						<span class="demo-rec flex items-center gap-2 text-lg font-medium">
							<span class="size-3 rounded-full bg-red-600"></span>
							Recording <span class="tabular-nums" data-rec-count>0:00</span>
						</span>
						<button type="button" data-action="send" class="inline-flex h-11 items-center rounded-lg bg-primary px-5 text-sm font-semibold text-primary-foreground hover:bg-primary/90 focus-visible:ring-4 focus-visible:ring-ring/50 focus-visible:outline-none">
							Send message
						</button>
					</div>
					<div data-when="sent" hidden class="flex flex-col items-center gap-3">
						<span class="flex size-12 items-center justify-center rounded-full bg-muted">
							@icon.Check(icon.Props{Class: "size-6"})
						</span>
						<p class="text-lg font-medium">Message sent. Thanks for calling!</p>
						<p class="text-sm text-muted-foreground">Joe gets a notification right away.</p>
					</div>
					<button type="button" data-action="reset" data-when="book hours sent" hidden class="text-sm font-medium underline underline-offset-4 hover:text-muted-foreground">
						Start the demo again
					</button>
				</div>
			</div>
			<div class="flex flex-col bg-muted/30">
				<div class="border-b px-4 py-2.5 text-xs text-muted-foreground">Joe's phone</div>
				<div class="flex flex-1 items-center justify-center p-8">
					<div class="flex h-[340px] w-[200px] flex-col rounded-[2rem] border-[6px] border-foreground/85 bg-background p-4">
						<div class="flex items-center justify-between text-[11px] text-muted-foreground">
							<span>minivoip</span>
							<span class="flex items-center gap-1"><span class="size-1.5 rounded-full bg-emerald-600"></span>Ready</span>
						</div>
						<div class="flex flex-1 flex-col items-center justify-center gap-3 text-center">
							<div data-when="idle greeting menu book hours" class="flex flex-col items-center gap-2">
								@icon.Smartphone(icon.Props{Class: "size-8 text-muted-foreground"})
								<p class="text-sm font-medium">Waiting for calls</p>
								<p class="text-xs text-muted-foreground">Your cell stays in your pocket until a caller picks "Talk to Joe".</p>
							</div>
							<div data-when="ringing" hidden class="demo-incoming flex w-full flex-col items-center gap-2">
								<p class="text-xs text-muted-foreground">Website call</p>
								<p class="text-base font-semibold">Joe's B&amp;B line</p>
								<p class="text-xs text-muted-foreground">Pressed 2: Talk to Joe</p>
								<div class="mt-4 flex w-full justify-around">
									<span class="flex size-11 items-center justify-center rounded-full bg-red-600 text-white" aria-hidden="true">
										@icon.Phone(icon.Props{Class: "size-5 rotate-[135deg]"})
									</span>
									<span class="demo-ring flex size-11 items-center justify-center rounded-full bg-emerald-600 text-white" aria-hidden="true">
										@icon.Phone(icon.Props{Class: "size-5"})
									</span>
								</div>
								<p class="mt-3 text-[11px] text-muted-foreground">Joe's laptop is ringing too</p>
							</div>
							<div data-when="voicemail recording" hidden class="flex flex-col items-center gap-2">
								@icon.Voicemail(icon.Props{Class: "size-8 text-muted-foreground"})
								<p class="text-sm font-medium">Missed call</p>
								<p class="text-xs text-muted-foreground">The caller is leaving a message…</p>
							</div>
							<div data-when="sent" hidden class="w-full rounded-xl border bg-card p-3 text-left shadow-sm">
								<p class="flex items-center gap-1.5 text-xs font-semibold">
									@icon.Voicemail(icon.Props{Class: "size-3.5"})
									New voicemail
								</p>
								<p class="mt-1 text-xs text-muted-foreground">Website visitor · <span data-rec-final>0:05</span></p>
								<p class="mt-2 text-xs font-medium underline underline-offset-2">Tap to play</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<p class="mt-4 text-center text-sm text-muted-foreground">A demo with a sample business. Nothing rings and nothing is recorded.</p>
	</section>
}

templ voiceBars() {
	<span class="voice-bars flex h-10 items-center gap-1" aria-hidden="true">
		for i := 0; i < 9; i++ {
			<span class="w-1.5 rounded-full bg-foreground" style={ "animation-delay:" + delay(i) }></span>
		}
	</span>
}

func delay(i int) string {
	return []string{"0ms", "-320ms", "-640ms", "-160ms", "-480ms", "-800ms", "-240ms", "-560ms", "-80ms"}[i]
}

templ menuKey(key, label, hint, action string) {
	<button type="button" data-action={ action } class="flex items-center gap-3 rounded-lg border bg-background px-3 py-2.5 text-left transition-colors hover:bg-muted focus-visible:ring-4 focus-visible:ring-ring/50 focus-visible:outline-none">
		<span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-primary text-sm font-bold text-primary-foreground">{ key }</span>
		<span class="flex flex-col">
			<span class="text-sm font-semibold">{ label }</span>
			<span class="text-xs text-muted-foreground">{ hint }</span>
		</span>
	</button>
}

templ featureGrid() {
	<section id="features" class="border-t bg-muted/30 py-24">
		<div class="mx-auto max-w-6xl px-4">
			<div class="mx-auto mb-14 max-w-2xl text-center">
				<h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">Everything a good receptionist does</h2>
				<p class="mt-3 text-muted-foreground">On the cell phone you already carry. Set it up once, and change your greeting and choices whenever you like.</p>
			</div>
			<div class="grid overflow-hidden rounded-2xl border bg-border gap-px sm:grid-cols-2 lg:grid-cols-3">
				for _, f := range features {
					<div class="flex flex-col gap-3 bg-background p-7">
						<span class="flex size-10 items-center justify-center rounded-lg bg-primary/10 text-primary dark:bg-primary/15">
							@f.Icon(icon.Props{Class: "size-5"})
						</span>
						<h3 class="font-semibold">{ f.Title }</h3>
						<p class="text-sm leading-relaxed text-muted-foreground">{ f.Text }</p>
					</div>
				}
				<div class="flex flex-col gap-3 bg-background p-7 sm:col-span-2 sm:flex-row sm:items-center sm:gap-5 lg:col-span-3">
					<span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground">
						@aiFeature.Icon(icon.Props{Class: "size-5"})
					</span>
					<div class="flex flex-col gap-1">
						<h3 class="flex items-center gap-2 font-semibold">
							{ aiFeature.Title }
							@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
								Coming soon
							}
						</h3>
						<p class="text-sm leading-relaxed text-muted-foreground">{ aiFeature.Text }</p>
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ howItWorks() {
	<section id="how" class="py-24">
		<div class="mx-auto max-w-6xl px-4">
			<div class="mx-auto mb-14 max-w-2xl text-center">
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Set up in three steps</h2>
				<p class="mt-3 text-muted-foreground">You set it all up yourself, from your browser.</p>
			</div>
			<ol class="grid gap-10 md:grid-cols-3 md:gap-8">
				for i, s := range steps {
					<li class="flex flex-col gap-3">
						<span class="flex size-9 items-center justify-center rounded-full border text-sm font-semibold tabular-nums">{ stepNumber(i) }</span>
						<h3 class="text-lg font-semibold">{ s.Title }</h3>
						<p class="leading-relaxed text-muted-foreground">{ s.Text }</p>
					</li>
				}
			</ol>
			<div class="mx-auto mt-14 max-w-2xl overflow-x-auto rounded-xl border bg-muted/40 px-5 py-4 font-mono text-sm">
				<code>&lt;script src="https://minivoip.example/w.js" data-line="joesbnb"&gt;&lt;/script&gt;</code>
			</div>
			<p class="mt-3 text-center text-sm text-muted-foreground">The one line you paste into your website (example line name).</p>
		</div>
	</section>
}

func stepNumber(i int) string {
	return []string{"1", "2", "3"}[i]
}

templ pricing() {
	<section id="pricing" class="border-t bg-muted/30 py-24">
		<div class="mx-auto max-w-6xl px-4">
			<div class="mx-auto mb-12 max-w-2xl text-center">
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">One line, one price</h2>
				<p class="mt-3 text-muted-foreground">About the price of a coffee a month.</p>
			</div>
			<div class="mx-auto max-w-md rounded-2xl border bg-background p-8 shadow-[0_24px_60px_-34px_rgb(0_0_0/0.35)]">
				<div class="flex items-center justify-between">
					<h3 class="font-semibold">minivoip line</h3>
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						Beta
					}
				</div>
				<p class="mt-6 flex items-baseline gap-2">
					<span class="text-5xl font-bold tracking-tight">Free</span>
					<span class="text-muted-foreground">while in beta</span>
				</p>
				<p class="mt-2 text-sm text-muted-foreground">Then $30 a year per line, about $2.50 a month.</p>
				<ul class="mt-8 flex flex-col gap-3 text-sm">
					for _, item := range included {
						<li class="flex items-start gap-2.5">
							@icon.Check(icon.Props{Class: "mt-0.5 size-4 shrink-0"})
							{ item }
						</li>
					}
				</ul>
				@button.Button(button.Props{Href: "/signup", Size: button.SizeLg, Class: "mt-8 h-11 w-full text-base"}) {
					Get my free line
				}
				<p class="mt-4 text-center text-sm text-muted-foreground">Have a promo code? Enter it when you sign up.</p>
			</div>
		</div>
	</section>
}

templ faqList() {
	<section id="faq" class="py-24">
		<div class="mx-auto max-w-3xl px-4">
			<h2 class="mb-10 text-center text-3xl font-bold tracking-tight sm:text-4xl">Questions</h2>
			<div class="divide-y border-y">
				for _, f := range faqs {
					<details class="group py-5">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium [&::-webkit-details-marker]:hidden">
							{ f.Q }
							@icon.Plus(icon.Props{Class: "size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45"})
						</summary>
						<p class="mt-3 leading-relaxed text-muted-foreground">{ f.A }</p>
					</details>
				}
			</div>
		</div>
	</section>
}

templ finalCall() {
	<section class="px-4 pb-24">
		<div class="mx-auto flex max-w-6xl flex-col items-center gap-6 rounded-3xl bg-primary px-6 py-16 text-center text-primary-foreground">
			<h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">Give your website a receptionist</h2>
			<p class="max-w-xl text-primary-foreground/75">Record your greeting, install the app, paste one line. Free while in beta.</p>
			@button.Button(button.Props{Href: "/signup", Variant: button.VariantSecondary, Size: button.SizeLg, Class: "h-11 px-6 text-base"}) {
				Get my free line
			}
		</div>
	</section>
}

templ siteFooter() {
	<footer class="border-t py-10">
		<div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 text-sm text-muted-foreground sm:flex-row">
			<div class="flex items-center gap-3">
				@brand()
				<span>Part of the mini family, with minipass and minicrm.</span>
			</div>
			<a href="mailto:kdresdell@minipass.me" class="underline-offset-4 hover:text-foreground hover:underline">kdresdell@minipass.me</a>
		</div>
	</footer>
}
