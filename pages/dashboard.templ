package pages

import (
	"strconv"

	"minivoip/components/button"
	"minivoip/components/icon"
	"minivoip/components/input"
	"minivoip/components/textarea"
	"minivoip/layouts"
	"minivoip/lines"
)

// LineForm is the "create your line" form shown back after an error.
type LineForm struct {
	Business string
	Name     string // the call link's last part; suggested from Business
	Custom   bool   // show the link field open (an error, or the owner changed it)
	Host     string // this site's address, for the link preview
	Error    string
}

// dashShell is the logged-in frame: logo, sections, email and log out.
templ dashShell(title, email, current string) {
	@layouts.Base(title+" · minivoip", "") {
		<header class="border-b bg-background">
			<div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-3 px-4 py-3">
				@brand()
				<nav class="order-last -mx-1 flex w-full items-center gap-1 overflow-x-auto text-sm whitespace-nowrap md:order-none md:mx-0 md:w-auto">
					@dashLink("/dashboard", "My line", current)
					@dashLink("/dashboard/menu", "Voice menu", current)
					@dashLink("/dashboard/voicemail", "Voicemail", current)
					@dashLink("/app", "Phone app", current)
					if isAdmin(ctx) {
						@dashLink("/admin/promo", "Admin", current)
					}
				</nav>
				<form method="post" action="/logout" class="flex items-center gap-3 text-sm text-muted-foreground">
					<span class="hidden sm:inline">{ email }</span>
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
						Log out
					}
				</form>
			</div>
		</header>
		<main class="mx-auto min-h-[calc(100dvh-8rem)] max-w-4xl px-4 py-10">
			{ children... }
		</main>
		@smallFooter()
	}
}

templ dashLink(href, text, current string) {
	if href == current {
		<a href={ templ.SafeURL(href) } class="rounded-md bg-muted px-3 py-1.5 font-medium" aria-current="page">{ text }</a>
	} else {
		<a href={ templ.SafeURL(href) } class="rounded-md px-3 py-1.5 text-muted-foreground hover:bg-muted hover:text-foreground">{ text }</a>
	}
}

templ panel() {
	<section class="rounded-2xl border bg-background p-6 sm:p-8">
		{ children... }
	</section>
}

// NewLine is step 2 of sign up: the business name, which also makes the
// call link (dashboard.js shows it as you type; "Change" edits it).
templ NewLine(email string, f LineForm) {
	@accountShell("Your business") {
		@stepLabel("Step 2 of 2: your business")
		<h1 class="text-2xl font-bold tracking-tight">What's your business called?</h1>
		<p class="mt-1 text-sm text-muted-foreground">Callers see and hear this name, beside your logo.</p>
		<form method="post" action="/dashboard/line" enctype="multipart/form-data" class="mt-6 flex flex-col gap-5" data-new-line>
			@formError(f.Error)
			@formField("business", "Business name") {
				@input.Input(input.Props{ID: "business", Name: "business", Value: f.Business, Required: true, Placeholder: "Joe's B&B", Attributes: templ.Attributes{"autofocus": "", "autocomplete": "organization", "data-business": ""}})
			}
			<div class="rounded-xl border bg-muted/40 p-4">
				<p class="text-xs font-medium text-muted-foreground">Your call link</p>
				<p class="mt-1 font-mono text-sm break-all">{ f.Host }/call/<span class="font-semibold" data-link-preview>{ previewName(f) }</span></p>
				<p class="mt-2 text-xs text-muted-foreground">Share it, print it as a QR code, or put it behind a Call button on your website. We make it from your business name.</p>
				<button type="button" class="mt-2 text-xs font-medium underline underline-offset-4" data-link-edit
					if f.Custom {
						hidden
					}
				>Change it</button>
				<div class="mt-3"
					if !f.Custom {
						hidden
					}
					data-link-field
				>
					@formField("name", "Link name") {
						@input.Input(input.Props{ID: "name", Name: "name", Value: customName(f), Placeholder: "joes-bnb", Attributes: templ.Attributes{"autocomplete": "off", "autocapitalize": "none", "pattern": "[a-z0-9][a-z0-9\\-]{1,28}[a-z0-9]"}})
						<p class="text-xs text-muted-foreground">3 to 30 lowercase letters, numbers or dashes. It can't change later.</p>
					}
				</div>
			</div>
			@formField("logo", "Your logo (optional)") {
				<div class="flex items-center gap-3">
					<img data-logo-preview hidden alt="Your logo, framed" class="size-14 flex-none rounded-xl bg-white object-contain ring-1 ring-border"/>
					@input.Input(input.Props{ID: "logo", Name: "logo", Type: "file", Accept: logoAccept, Attributes: templ.Attributes{"data-logo-input": ""}})
				</div>
				<p class="text-sm text-destructive" data-logo-error hidden role="alert"></p>
				<p class="text-xs text-muted-foreground">{ logoHint }</p>
			}
			@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg, Class: "h-10 w-full"}) {
				Create my line
			}
		</form>
		<form method="post" action="/logout" class="mt-6 text-center text-sm text-muted-foreground">
			Signed in as { email }.
			<button type="submit" class="font-medium text-foreground underline underline-offset-4">Log out</button>
		</form>
		@logoCrop()
		<script src="/assets/js/dashboard.js" defer></script>
	}
}

func previewName(f LineForm) string {
	if f.Name != "" {
		return f.Name
	}
	if f.Business != "" {
		return lines.Suggest(f.Business)
	}
	return "your-business"
}

func customName(f LineForm) string {
	if f.Custom {
		return f.Name
	}
	return ""
}

const logoAccept = "image/png,image/jpeg,image/webp"
const logoHint = "Callers see it when they call you and in your meeting room. Pick a PNG, JPG or WebP picture; you frame it next."

// logoCrop is the window where the owner frames the logo they picked
// (assets/js/logo.js, with Cropper.js).
templ logoCrop() {
	<link rel="stylesheet" href="/assets/vendor/cropperjs-1.6.2/cropper.min.css"/>
	<style>[data-logo-crop] .cropper-view-box { outline: 2px solid #fff; outline-color: #fff; } [data-logo-crop] .cropper-line, [data-logo-crop] .cropper-point { display: none; }</style>
	<dialog data-logo-crop aria-labelledby="logo-crop-title" class="m-auto w-[min(26rem,calc(100vw-2rem))] overflow-hidden rounded-2xl border bg-background p-0 text-foreground shadow-2xl backdrop:bg-black/50">
		<div class="px-5 pt-5">
			<h2 id="logo-crop-title" class="font-semibold">Frame your logo</h2>
			<p class="mt-1 text-sm text-muted-foreground">Drag to move it, zoom to fit. The square is what callers see.</p>
		</div>
		<div class="mt-4 h-80 bg-muted">
			<img data-logo-crop-img alt="" class="block max-w-full"/>
		</div>
		<div class="flex items-center gap-2 px-5 pt-4">
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon, Attributes: templ.Attributes{"data-crop": "out", "aria-label": "Zoom out"}}) {
				@icon.ZoomOut()
			}
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon, Attributes: templ.Attributes{"data-crop": "in", "aria-label": "Zoom in"}}) {
				@icon.ZoomIn()
			}
			@button.Button(button.Props{Variant: button.VariantOutline, Attributes: templ.Attributes{"data-crop": "fit"}}) {
				@icon.Scan()
				Whole logo
			}
		</div>
		<div class="flex justify-end gap-2 p-5">
			@button.Button(button.Props{Variant: button.VariantGhost, Attributes: templ.Attributes{"data-crop": "cancel"}}) {
				Cancel
			}
			@button.Button(button.Props{Attributes: templ.Attributes{"data-crop": "use"}}) {
				Use this logo
			}
		</div>
	</dialog>
	<script src="/assets/vendor/cropperjs-1.6.2/cropper.min.js" defer></script>
	<script src="/assets/js/logo.js" defer></script>
}

// dashBadge is the business's logo (or initials) on the dashboard.
templ dashBadge(l lines.Line, size string) {
	if l.Logo != "" {
		<span class={ "grid flex-none place-items-center overflow-hidden rounded-2xl bg-white ring-1 ring-border", size } data-logo-badge><img src={ logoURL(l) } alt={ l.Business + " logo" } class="size-[84%] object-contain"/></span>
	} else {
		<span class={ "grid flex-none place-items-center rounded-2xl bg-foreground font-semibold text-background", size } aria-hidden="true">{ initials(l.Business) }</span>
	}
}

// logoNote says what just happened to the logo (?logo= on the dashboard).
func logoNote(msg string) (text string, bad bool) {
	switch msg {
	case "saved":
		return "Saved. Callers see your new logo right away.", false
	case "removed":
		return "Removed. Callers see your initials instead.", false
	case "bad":
		return "That file can't be a logo. Use a PNG, JPG or WebP picture of 2 MB or less.", true
	}
	return "", false
}

// Dashboard is "My line": the call link and what to do next.
templ Dashboard(email string, l lines.Line, callURL, roomURL string, newVoicemails int, plan, logoMsg string) {
	@dashShell("My line", email, "/dashboard") {
		<div class="flex items-center gap-4">
			@dashBadge(l, "size-14 text-lg")
			<h1 class="text-3xl font-bold tracking-tight">{ l.Business }</h1>
		</div>
		<p class="mt-2 text-muted-foreground">Your receptionist answers at this link. Share it, or put it behind a Call button on your website.</p>
		<p class="mt-1 text-sm text-muted-foreground" data-plan>{ plan }</p>
		<div class="mt-8 flex flex-col gap-6">
			@panel() {
				<h2 class="font-semibold">Your call link</h2>
				<div class="mt-3 flex flex-col gap-2 sm:flex-row">
					@input.Input(input.Props{ID: "call-link", Value: callURL, ReadOnly: true, Class: "font-mono text-sm"})
					@button.Button(button.Props{Variant: button.VariantOutline, Attributes: templ.Attributes{"data-copy": "call-link"}}) {
						@icon.Copy()
						Copy
					}
					@button.Button(button.Props{Href: callURL, Target: "_blank"}) {
						@icon.PhoneCall()
						Test call
					}
				</div>
			}
			@panel() {
				<div id="logo" class="scroll-mt-6">
					<h2 class="flex items-center gap-2 font-semibold">
						@icon.Image(icon.Props{Class: "size-4"})
						Your logo
					</h2>
					if text, bad := logoNote(logoMsg); bad {
						<div class="mt-3">
							@formError(text)
						</div>
					} else if text != "" {
						<p class="mt-3 rounded-lg border border-emerald-600/30 bg-emerald-600/10 px-3 py-2 text-sm text-emerald-700 dark:text-emerald-400" role="status">{ text }</p>
					}
					<div class="mt-3 flex flex-col gap-4 sm:flex-row sm:items-center">
						@dashBadge(l, "size-20 text-2xl")
						<div class="flex min-w-0 flex-1 flex-col gap-2">
							<form method="post" action="/dashboard/logo" enctype="multipart/form-data" class="flex flex-col gap-2 sm:flex-row" data-logo-form>
								@input.Input(input.Props{ID: "logo-file", Name: "logo", Type: "file", Accept: logoAccept, Required: true, Attributes: templ.Attributes{"aria-label": "Logo file", "data-logo-input": "", "data-logo-submit": ""}})
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
									if l.Logo != "" {
										Change logo
									} else {
										Add my logo
									}
								}
							</form>
							<p class="text-sm text-destructive" data-logo-error hidden role="alert"></p>
							<p class="text-xs text-muted-foreground">
								{ logoHint }
								The name comes from your <a href="/dashboard/menu" class="underline underline-offset-4">voice menu</a>.
							</p>
							if l.Logo != "" {
								<form method="post" action="/dashboard/logo/remove">
									<button type="submit" class="text-xs font-medium text-muted-foreground underline underline-offset-4 hover:text-foreground">Remove the logo</button>
								</form>
							}
						</div>
					</div>
				</div>
			}
			@panel() {
				<h2 class="flex items-center gap-2 font-semibold">
					@icon.Video(icon.Props{Class: "size-4"})
					Meeting room
				</h2>
				if l.Premium {
					<p class="mt-2 text-sm text-muted-foreground">Your own room for video meetings: voice, cameras, screen sharing and a whiteboard. Send the link; people join from their browser, nothing to install. They wait until you open the room.</p>
					<div class="mt-3 flex flex-col gap-2 sm:flex-row">
						@input.Input(input.Props{ID: "room-link", Value: roomURL, ReadOnly: true, Class: "font-mono text-sm"})
						@button.Button(button.Props{Variant: button.VariantOutline, Attributes: templ.Attributes{"data-copy": "room-link"}}) {
							@icon.Copy()
							Copy
						}
						@button.Button(button.Props{Href: roomURL, Target: "_blank"}) {
							@icon.Video()
							Open the room
						}
					</div>
				} else {
					<p class="mt-2 text-sm text-muted-foreground" data-room-locked>
						<span class="mr-1 rounded-full bg-foreground px-2 py-0.5 text-xs font-semibold text-background">Premium</span>
						Your own room for video meetings, plus a camera, screen sharing and a whiteboard in your calls. You're on Basic; Premium opens after the beta.
					</p>
				}
			}
			<div class="grid gap-6 md:grid-cols-3">
				@panel() {
					<h2 class="flex items-center gap-2 font-semibold">
						@icon.Voicemail(icon.Props{Class: "size-4"})
						Voicemail
					</h2>
					<p class="mt-2 text-sm text-muted-foreground" data-new-voicemails>
						if newVoicemails == 1 {
							1 new message.
						} else if newVoicemails > 1 {
							{ strconv.Itoa(newVoicemails) } new messages.
						} else {
							No new messages.
						}
					</p>
					@button.Button(button.Props{Href: "/dashboard/voicemail", Variant: button.VariantOutline, Size: button.SizeSm, Class: "mt-4"}) {
						Listen
					}
				}
				@panel() {
					<h2 class="flex items-center gap-2 font-semibold">
						@icon.ListTree(icon.Props{Class: "size-4"})
						Voice menu
					</h2>
					<p class="mt-2 text-sm text-muted-foreground">"{ l.Greeting } { l.Menu() }"</p>
					@button.Button(button.Props{Href: "/dashboard/menu", Variant: button.VariantOutline, Size: button.SizeSm, Class: "mt-4"}) {
						Edit the menu
					}
				}
				@panel() {
					<h2 class="flex items-center gap-2 font-semibold">
						@icon.Smartphone(icon.Props{Class: "size-4"})
						Phone app
					</h2>
					<p class="mt-2 text-sm text-muted-foreground">Open it on your phone, log in, and turn on notifications: your phone then rings even when the app is closed. On iPhone, add it to your home screen first.</p>
					@button.Button(button.Props{Href: "/app", Variant: button.VariantOutline, Size: button.SizeSm, Class: "mt-4"}) {
						Open the phone app
					}
				}
			</div>
		</div>
		@logoCrop()
		<script src="/assets/js/dashboard.js" defer></script>
	}
}

// MenuEditor edits the greeting and the choices. dashboard.js adds and
// removes choice rows and plays a preview.
templ MenuEditor(email string, l lines.Line, saved bool, errMsg string) {
	@dashShell("Voice menu", email, "/dashboard/menu") {
		<h1 class="text-3xl font-bold tracking-tight">Voice menu</h1>
		<p class="mt-2 text-muted-foreground">What your receptionist says, and where each choice sends the caller. Type it for a computer voice to read, or record it in your own voice.</p>
		<form method="post" action="/dashboard/menu" class="mt-8 flex flex-col gap-6" data-menu-form>
			@formError(errMsg)
			if saved {
				<p class="rounded-lg border border-emerald-600/30 bg-emerald-600/10 px-3 py-2 text-sm text-emerald-700 dark:text-emerald-400" role="status">Saved. Callers hear the new menu right away.</p>
			}
			@panel() {
				@formField("business", "Business name") {
					@input.Input(input.Props{ID: "business", Name: "business", Value: l.Business, Required: true})
					<p class="text-xs text-muted-foreground">Callers see it on the call page and hear "Ringing { l.Business }".</p>
				}
				<div class="mt-5">
					@formField("greeting", "Welcome message") {
						@textarea.Textarea(textarea.Props{ID: "greeting", Name: "greeting", Value: l.Greeting, Rows: 2})
						<p class="text-xs text-muted-foreground">Callers hear this first, then the list of choices, read by a computer voice.</p>
						@recorder("greeting_audio", l.GreetingAudio, "Or record it in your own voice. Say your choices in it too (\"press 1 for bookings\"): callers hear your recording instead of the text and the list.")
					}
				</div>
			}
			@panel() {
				<div class="flex items-center justify-between gap-4">
					<h2 class="font-semibold">Choices</h2>
					@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-add-choice": ""}}) {
						@icon.Plus()
						Add a choice
					}
				</div>
				<div class="mt-5 flex flex-col gap-4" data-choices>
					for _, o := range l.Options {
						@choiceRow(o)
					}
				</div>
				<template data-choice-template>
					@choiceRow(lines.Option{Action: lines.Ring})
				</template>
			}
			<div class="flex flex-wrap items-center gap-3">
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg, Class: "h-10"}) {
					Save the menu
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeLg, Class: "h-10", Attributes: templ.Attributes{"data-preview": ""}}) {
					@icon.Play()
					Hear it
				}
				<span class="text-sm text-muted-foreground" data-preview-text></span>
			</div>
		</form>
		<script src="/assets/js/dashboard.js" defer></script>
	}
}

// recorder records a prompt in the owner's voice (dashboard.js). The hidden
// field carries the recording's name when the menu is saved; empty means
// the computer voice reads the text.
templ recorder(name, value, hint string) {
	<div class="flex flex-col gap-2" data-recorder>
		<input type="hidden" name={ name } value={ value } data-rec-value/>
		<div class="flex flex-wrap items-center gap-2">
			<button type="button" data-rec-start class="inline-flex h-8 items-center gap-1.5 rounded-lg border bg-background px-2.5 text-xs font-medium hover:bg-muted focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none">
				@icon.Mic(icon.Props{Class: "size-3.5"})
				if value == "" {
					<span data-rec-start-label>Record my voice</span>
				} else {
					<span data-rec-start-label>Record again</span>
				}
			</button>
			<button type="button" data-rec-stop hidden class="inline-flex h-8 items-center gap-1.5 rounded-lg bg-red-600 px-2.5 text-xs font-medium text-white hover:bg-red-700 focus-visible:ring-3 focus-visible:ring-red-600/30 focus-visible:outline-none">
				@icon.Square(icon.Props{Class: "size-3"})
				Stop <span class="tabular-nums" data-rec-timer>0:00</span>
			</button>
			<audio controls preload="none" class="h-8 max-w-full" data-rec-audio
				if value != "" {
					src={ "/prompt/" + value }
				} else {
					hidden
				}
			></audio>
			<button type="button" data-rec-clear class="h-8 px-1 text-xs text-muted-foreground underline underline-offset-4 hover:text-foreground"
				if value == "" {
					hidden
				}
			>Use the computer voice instead</button>
			<span class="text-xs text-muted-foreground" data-rec-status role="status"></span>
		</div>
		if hint != "" {
			<p class="text-xs text-muted-foreground">{ hint }</p>
		}
	</div>
}

// selectClass matches the input component's look for a native select.
const selectClass = "h-9 w-full rounded-lg border border-input bg-transparent px-2.5 text-sm outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 dark:bg-input/30"

templ choiceRow(o lines.Option) {
	<div class="grid gap-3 rounded-xl border bg-muted/30 p-4 sm:grid-cols-[4.5rem_minmax(0,1fr)_minmax(0,1fr)_auto] sm:items-start" data-choice>
		<label class="flex flex-col gap-1.5 text-xs font-medium text-muted-foreground">
			Key
			@input.Input(input.Props{Name: "key", Value: o.Key, Class: "text-center font-semibold", Attributes: templ.Attributes{"maxlength": "1", "inputmode": "numeric", "aria-label": "Key the caller presses"}})
		</label>
		<label class="flex flex-col gap-1.5 text-xs font-medium text-muted-foreground">
			Name
			@input.Input(input.Props{Name: "label", Value: o.Label, Placeholder: "Bookings"})
		</label>
		<label class="flex flex-col gap-1.5 text-xs font-medium text-muted-foreground">
			Does
			<select name="action" class={ selectClass } data-action-select>
				for _, a := range lines.Actions {
					<option value={ string(a.Value) } selected?={ a.Value == o.Action }>{ a.Label }</option>
				}
			</select>
		</label>
		<button type="button" class="order-first flex size-9 items-center justify-center justify-self-end rounded-lg text-muted-foreground hover:bg-muted hover:text-foreground sm:order-none sm:mt-5 sm:self-start" data-remove-choice aria-label="Remove this choice">
			@icon.Trash2(icon.Props{Class: "size-4"})
		</button>
		<label class="flex flex-col gap-1.5 text-xs font-medium text-muted-foreground sm:col-span-3 sm:col-start-2">
			<span data-say-label>Message</span>
			@input.Input(input.Props{Name: "say", Value: o.Say, Placeholder: "Please hold, I'm ringing you."})
		</label>
		<div class="sm:col-span-3 sm:col-start-2">
			@recorder("say_audio", o.SayAudio, "")
		</div>
		<label class="flex flex-col gap-1.5 text-xs font-medium text-muted-foreground sm:col-span-3 sm:col-start-2" data-url-field>
			Web address
			@input.Input(input.Props{Name: "url", Value: o.URL, Type: "url", Placeholder: "https://joesbnb.example/booking"})
		</label>
	</div>
}
