}

templ icCheck() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
}

templ icTrash() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
}

templ icHangup() {
	<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 14.6c4.6-4.1 12.2-4.1 16.8 0 .6.5.7 1.4.2 2l-1.3 1.6c-.4.5-1.1.6-1.7.4l-2.6-1a1.4 1.4 0 0 1-.9-1.3v-1.7a10 10 0 0 0-4.2 0v1.7c0 .6-.4 1.1-.9 1.3l-2.6 1c-.6.2-1.3.1-1.7-.4l-1.3-1.6c-.5-.6-.4-1.5.2-2Z"></path></svg>
}

// ----------------------------------------------------------------- pieces

// Availability is the band on top of the call list that says whether calls
// ring, with the switch: three buttons on a computer, Change and a menu on a
// phone. POST /app/available sends it back when the owner changes it; the
// words for every state are there and app.css shows the one for data-mode.
templ Availability(until string) {
	{{ label, on := availability(until) }}
	{{ mode := availMode(until) }}
	<div class="ap-status" data-avail-state data-mode={ mode } data-on={ strconv.FormatBool(on) } data-until={ pauseEnd(until) }>
		<i class="ap-dot" aria-hidden="true"></i>
		<p class="ap-status-text" role="status">
			<span data-for="on"><b>You're available<span class="ap-wide">.</span></b> <span class="ap-wide">Calls ring on this computer and on your phone.</span><span class="ap-narrow">Calls ring on this phone.</span></span>
			<span data-for="pause">
				<b>
					if mode == "pause" {
						{ label }<span class="ap-wide">.</span>
					} else {
						Paused
					}
				</b> Callers can leave a message.
			</span>
			<span data-for="off"><b>You're off<span class="ap-wide">.</span></b> Every call goes to a message.</span>
		</p>
		<div class="ap-seg" role="group" aria-label="Do calls ring?" data-avail-seg>
			<button type="button" data-mode="on" aria-pressed={ strconv.FormatBool(mode == "on") }>
				@icCheck()
				Available
			</button>
			<button type="button" data-mode="pause" aria-pressed={ strconv.FormatBool(mode == "pause") }>Pause 1 hour</button>
			<button type="button" data-mode="off" aria-pressed={ strconv.FormatBool(mode == "off") }>Off</button>
		</div>
		<div class="ap-avail">
			<button type="button" class="ap-avail-btn" data-avail-btn aria-haspopup="true" aria-expanded="false" aria-label="Change whether calls ring">
				Change
				@icChevron()
			</button>
			<div class="ap-avail-menu" data-avail-menu hidden>
				<button type="button" data-mode="on"><b>Available</b><span>Calls ring on your devices</span></button>
				<button type="button" data-mode="pause"><b>Pause for 1 hour</b><span>Callers can leave a message</span></button>
				<button type="button" data-mode="off"><b>Off</b><span>Every call goes to a message</span></button>
			</div>
		</div>
	</div>
}

templ playButton(v store.Voicemail, label string) {
	<button type="button" class="ap-play" data-play aria-label={ label }>
		@icPlay()
	</button>
	<audio preload="none" src={ "/voicemail/" + idStr(v.ID) + "/audio" }></audio>
}

// messageTitle is "New message · 0:42" until it's played, then "Message ·
// 0:42": phone.js removes [data-new] when it plays.
templ messageTitle(v store.Voicemail) {
	<span class="ap-row-title">
		if !v.Listened {
			<span class="ap-title-new" data-new>New message</span>
		}
		<span class="ap-title-old">Message</span>
		<span class="ap-row-len">· { length(v) }</span>
	</span>
}

// historyRow is one call in the list. Voicemail rows play in place on the
// phone and open on the right on a computer.
templ historyRow(e store.HistoryEntry) {
	if e.Voicemail != nil {
		<li class="ap-row" data-kind="voicemail" data-voicemail={ idStr(e.Voicemail.ID) } data-len={ entryLength(e) } data-option={ e.Option } data-when={ when(e.At) }>
			<span class="ap-ico">
				@icVoicemail()
			</span>
			<button type="button" class="ap-row-main" data-open>
				@messageTitle(*e.Voicemail)
				<span class="ap-row-sub">{ chose(e.Option) }{ clock(e.At) }</span>
			</button>
			@playButton(*e.Voicemail, "Play message")
		</li>
	} else {
		<li class="ap-row" data-kind={ entryKind(e) }>
			<span class="ap-ico">
				switch {
					case e.Outcome == "answered":
						@icIncoming()
					case e.Outcome == "away":
						@icMoon()
					default:
						@icMissed()
				}
			</span>
			<span class="ap-row-main">
				<span class="ap-row-title">
					{ entryTitle(e) }
					if l := entryLength(e); l != "" {
						<span class="ap-row-len">· { l }</span>
					}
				</span>
				<span class="ap-row-sub">{ chose(e.Option) }{ clock(e.At) }</span>
			</span>
		</li>
	}
}

// AppCalls is the call list, grouped by day (also GET /app/calls).
templ AppCalls(list []store.HistoryEntry) {
	<div data-calls>
		if len(list) == 0 {
			<div class="ap-empty">
				<span class="ap-empty-ico">
					@icPhone()
				</span>
				<p class="ap-empty-title">No calls yet</p>
				<p>When someone calls from your website, the call shows up here.</p>
			</div>
		} else {
			<div class="ap-list">
				for _, g := range byDay(list) {
					<h2 class="ap-day">{ g.Label }</h2>
					<ul class="ap-group">
						for _, e := range g.Entries {
							@historyRow(e)
						}
					</ul>
				}
			</div>
		}
	</div>
}

// AppVoicemails is the list of messages (also GET /app/voicemails).
templ AppVoicemails(list []store.Voicemail) {
	<div data-voicemails>
		if len(list) == 0 {
			<div class="ap-empty">
				<span class="ap-empty-ico">
					@icVoicemail()
				</span>
				<p class="ap-empty-title">No messages yet</p>
				<p>When nobody answers, callers can leave a message. It shows up here.</p>
			</div>
		} else {
			<div class="ap-list">
				<ul class="ap-group">
					for _, v := range list {
						<li class="ap-row" data-kind="voicemail" data-voicemail={ idStr(v.ID) } data-len={ length(v) } data-option={ v.Option } data-when={ when(v.CreatedAt) }>
							<span class="ap-ico">
								@icVoicemail()
							</span>
							<button type="button" class="ap-row-main" data-open>
								@messageTitle(v)
								<span class="ap-row-sub">{ chose(v.Option) }{ when(v.CreatedAt) }</span>
							</button>
							<form method="post" action={ templ.SafeURL("/voicemail/" + idStr(v.ID) + "/delete") } class="ap-row-del">
								<input type="hidden" name="back" value="/app#messages"/>
								<button type="submit" class="ap-iconbtn" aria-label="Delete this message">
									@icTrash()
								</button>
							</form>
							@playButton(v, "Play message")
						</li>
					}
				</ul>
			</div>
		}
	</div>
}

// tab is one of the app's four places: in the menu on the left on a
// computer, at the bottom on a phone.
templ tab(name, label, short string) {
	<button type="button" class="ap-tab" role="tab" data-tab={ name } aria-controls={ "panel-" + name } aria-selected={ strconv.FormatBool(name == "calls") }>
		<span class="ap-tab-ico">
			switch name {
				case "calls":
					@icPhone()
				case "messages":
					@icVoicemail()
				case "menu":
					@icMenu()
				default:
					@icCamera()
			}
		</span>
		if short != "" {
			<span class="ap-wide">{ label }</span>
			<span class="ap-narrow">{ short }</span>
		} else {
			<span>{ label }</span>
		}
		if name == "messages" {
			<span class="ap-count" data-vm-count hidden></span>
		}
	</button>
}

// Phone is the owner's app: /app, on the phone and the computer. Four tabs
// (Calls, Messages, What callers hear, Room) in a menu on the left on a computer, at
// the bottom on a phone; the account (ringing, install, log out) opens from
// the round letter. On a computer a message opens on the right. An incoming
// call takes the whole screen (the whole window on a computer). phone.js runs
// it; data-show lists the call states each part appears in. Look: DESIGN.md
// "Owner app" (the dashboard's look).
templ Phone(d AppData) {
	@layouts.Lean("minivoip", "") {
		<link rel="stylesheet" href="/assets/css/fonts.css"/>
		<link rel="stylesheet" href="/assets/css/app.css"/>
		<link rel="stylesheet" href="/assets/css/stage.css"/>
		<link rel="stylesheet" href="/assets/css/hear.css"/>
		<div class="ap" data-phone data-view="calls" data-premium={ strconv.FormatBool(d.Line.Premium) } data-notes={ strconv.FormatBool(d.Line.Notes) } data-android-latest={ d.Android } data-line={ d.Line.Name } data-business={ d.Line.Business } data-vapid={ d.VapidKey } data-ring={ strconv.Itoa(d.RingSeconds) } data-me-name={ ownerName(d.Line) } data-me-initials={ initials(ownerName(d.Line)) } data-me-logo={ logoURL(d.Line) }>
			<div class="ap-offline" data-offline hidden role="status">Offline. Reconnecting…</div>
			if d.Line.Premium {
				<a class="ap-room-alert" href={ templ.SafeURL(d.RoomURL) } target="_blank" data-room-alert hidden={ len(d.RoomWaiting) == 0 } role="status">
					<i class="ap-dot" aria-hidden="true"></i>
					<span data-room-who>{ waitingText(d.RoomWaiting) }</span>
					<b>Join</b>
				</a>
			}
			<header class="ap-top">
				<img src="/assets/brand/logo-minivoip.svg" alt="minivoip" width="121" height="22"/>
				<button type="button" class="ap-avatar" data-tab="me" aria-label="Your account">{ firstLetter(d.Email) }</button>
			</header>
			<aside class="ap-side">
				<img class="ap-logo" src="/assets/brand/logo-minivoip.svg" alt="minivoip" width="132" height="24"/>
				<nav class="ap-tabs" role="tablist" aria-label="minivoip">
					@tab("calls", "Calls", "")
					@tab("messages", "Messages", "")
					@tab("menu", "What callers hear", "Callers hear")
					@tab("room", "Meeting room", "Room")
				</nav>
				<button type="button" class="ap-acct" data-tab="me">
					<span class="ap-avatar" aria-hidden="true">{ firstLetter(d.Email) }</span>
					<span class="ap-acct-who">
						<b>{ d.Line.Business }</b>
						<small>{ d.Email }</small>
					</span>
					<span class="ap-sr">Your account</span>
				</button>
			</aside>
			<main class="ap-main">
				<section class="ap-panel is-split" id="panel-calls" role="tabpanel" data-panel="calls">
					<header class="ap-head">
						<h1>Calls</h1>
					</header>
					@Availability(d.Line.AwayUntil)
					<div class="ap-box" data-calls-box>
						@AppCalls(d.History)
					</div>
				</section>
				<section class="ap-panel is-split" id="panel-messages" role="tabpanel" data-panel="messages" hidden>
					<header class="ap-head">
						<h1>Messages</h1>
						<p>What callers left when nobody answered.</p>
					</header>
					<div class="ap-box" data-voicemail-box>
						@AppVoicemails(d.Voicemails)
					</div>
				</section>
				<section class="ap-panel" id="panel-menu" role="tabpanel" data-panel="menu" hidden>
					@hearForm(d.Line, true)
					<h2 class="ap-day">Your call link</h2>
					<div class="ap-card ap-link">
						<span class="ap-link-url" data-call-url>{ d.CallURL }</span>
						<button type="button" class="ap-btn" data-copy>Copy</button>
					</div>
				</section>
				<section class="ap-panel" id="panel-room" role="tabpanel" data-panel="room" hidden>
					<header class="ap-head">
						<h1>Meeting room</h1>
						<p>Video meetings with your customers, in the browser.</p>
					</header>
					if d.Line.Premium {
						<h2 class="ap-day">Your room link</h2>
						<div class="ap-card ap-link">
							<span class="ap-link-url" data-room-url>{ d.RoomURL }</span>
							<button type="button" class="ap-btn" data-copy-room>Copy</button>
						</div>
						<div class="ap-actions ap-room-open">
							<a class="ap-btn is-ink" href={ templ.SafeURL(d.RoomURL) } target="_blank" data-room-open>
								@icCamera()
								Open the room
							</a>
						</div>
						<h2 class="ap-day">How it works</h2>
						<ul class="ap-group ap-steps">
							<li class="ap-row"><span class="ap-key">1</span><span class="ap-row-main"><span class="ap-row-title">Send the link</span><span class="ap-row-sub ap-wrap">By email or text. People join from their browser, nothing to install.</span></span></li>
							<li class="ap-row"><span class="ap-key">2</span><span class="ap-row-main"><span class="ap-row-title">They wait for you</span><span class="ap-row-sub ap-wrap">This app tells you when someone is waiting.</span></span></li>
							<li class="ap-row"><span class="ap-key">3</span><span class="ap-row-main"><span class="ap-row-title">Open the room</span><span class="ap-row-sub ap-wrap">Talk, turn cameras on, show your screen, draw on the whiteboard. Up to 4 people.</span></span></li>
						</ul>
					} else {
						<div class="ap-card ap-locked" data-room-locked>
							<p class="ap-locked-tag">Premium</p>
							<p class="ap-locked-text">Your own room for video meetings, plus a camera, screen sharing and a whiteboard in your calls. Up to 4 people, nothing to install.</p>
							<p class="ap-locked-sub">You're on Basic. Premium opens after the beta.</p>
						</div>
					}
				</section>
				<section class="ap-panel" id="panel-me" role="region" aria-label="Your account" data-panel="me" hidden>
					<header class="ap-head">
						<h1>Your account</h1>
						<p>{ d.Line.Business } · { d.Email }</p>
					</header>
					<h2 class="ap-day">Ringing</h2>
					<div class="ap-card ap-setting" data-push>
						<p class="ap-setting-title">Ring when the app is closed</p>
						<p class="ap-muted" data-push-state>Checking this device…</p>
						<p class="ap-muted" data-push-ios hidden>On iPhone: tap Share, then “Add to Home Screen”. Open minivoip from that icon and turn notifications on there.</p>
						<div class="ap-actions">
							<button type="button" class="ap-btn is-ink" data-push-on hidden>Turn on notifications</button>
							<button type="button" class="ap-btn" data-push-test hidden>Send a test</button>
							<button type="button" class="ap-textbtn" data-push-off hidden>Turn off on this device</button>
						</div>
						<p class="ap-muted ap-small">{ plural(d.Devices, "device has", "devices have") } notifications on. This device: <span data-conn>connecting…</span></p>
					</div>
					<h2 class="ap-day">Install</h2>
					<div class="ap-card ap-setting" data-install>
						<p class="ap-setting-title" data-install-title>Put minivoip on this device</p>
						<p class="ap-muted" data-install-text>Install the app to open it from your home screen or dock, in its own window.</p>
						<div class="ap-actions">
							<button type="button" class="ap-btn is-ink" data-install-btn hidden>Install minivoip</button>
							<a class="ap-btn is-ink" href="/download/minivoip.apk" data-android-get hidden>Get the Android app</a>
							<a class="ap-btn is-ink" href="/download/minivoip.apk" data-android-update hidden>Update the app</a>
						</div>
					</div>
					<form method="post" action="/logout" class="ap-logout">
						<input type="hidden" name="next" value="/app"/>
						<button type="submit" class="ap-btn">Log out</button>
					</form>
				</section>
				<aside class="ap-detail" aria-label="Details">
					<div class="ap-detail-idle" data-detail-idle>
						<span class="ap-empty-ico">
							@icPhone()
						</span>
						<h2>Calls ring here</h2>
						<p>Keep this window open, even behind your other work. A call fills this window with a ringtone, and an alert brings it to the front.</p>
						<dl class="ap-facts">
							<div><dt>Your call link</dt><dd>{ d.CallURL }</dd></div>
							<div><dt>Ringing</dt><dd>{ strconv.Itoa(d.RingSeconds) } s, then a message</dd></div>
						</dl>
					</div>
					<div class="ap-vm" data-detail-vm hidden>
						<p class="ap-vm-when" data-vm-when></p>
						<h2 data-vm-title></h2>
						<p class="ap-vm-option" data-vm-option></p>
						<div class="ap-player">
							<button type="button" class="ap-play is-big" data-vm-play aria-label="Play message">
								@icPlay()
							</button>
							<div class="ap-wave" data-vm-wave aria-hidden="true"></div>
							<span class="ap-time"><span data-vm-time>0:00</span> / <span data-vm-len></span></span>
							<i class="ap-progress" data-vm-bar hidden></i>
						</div>
						<form method="post" class="ap-actions" data-vm-delete>
							<input type="hidden" name="back" value="/app#messages"/>
							<button type="submit" class="ap-btn is-red">
								@icTrash()
								Delete
							</button>
						</form>
						<p class="ap-vm-hint">Callers are asked to say their name and phone number in the message.</p>
					</div>
				</aside>
			</main>
			<div class="ap-call" data-call-screen data-show="incoming connecting talking" hidden>
				<div class="ap-call-in">
					<p class="ap-call-state">
						<i class="ap-dot"></i>
						<span data-status role="status" aria-live="assertive">Incoming call from your website</span>
						<span data-timer></span>
					</p>
					<div class="ap-face">
						<i></i><i></i>
						@faceBadge(d.Line, ownerName(d.Line), "ap-face-badge")
					</div>
					<h2 class="ap-call-title" data-call-title>Someone wants to talk to you</h2>
					<p class="ap-call-sub" data-call-sub>A visitor on your website is calling.</p>
					<div class="ap-countdown" data-show="incoming" hidden>
						<div class="ap-countdown-bar"><i data-countdown-bar></i></div>
						<p data-countdown>Goes to voicemail</p>
					</div>
					<div class="ap-call-bar" data-show="incoming" hidden>
						<button type="button" class="ap-answer" data-action="accept">
							@icPhone()
							<span>Answer</span>
						</button>
						<button type="button" class="ap-decline" data-action="decline">Decline</button>
						<p class="ap-call-note">If you decline, they can leave a message.</p>
					</div>
					<div class="ap-stage" data-stage></div>
					<p class="ap-meet-note" data-meet-note role="status" hidden></p>
					<p class="ap-rec-note" data-rec-note role="status" hidden></p>
					<div class="ap-call-bar is-live" data-show="connecting talking" hidden>
						<button type="button" class="ap-btn ap-tool" data-action="mute" aria-pressed="false">
							@icMic()
							<span>Mute</span>
						</button>
						if d.Line.Premium {
							<button type="button" class="ap-btn ap-tool" data-action="camera" aria-pressed="false">
								@icCamera()
								<span>Camera</span>
							</button>
							<button type="button" class="ap-btn ap-tool" data-action="screen" aria-pressed="false" data-share-btn hidden>
								@icScreen()
								<span>Screen</span>
							</button>
							<button type="button" class="ap-btn ap-tool" data-action="board" aria-pressed="false">
								@icBoard()
								<span>Whiteboard</span>
							</button>
						}
						<button type="button" class="ap-hangup" data-action="hangup">
							@icHangup()
							<span>Hang up</span>
						</button>
					</div>
				</div>
			</div>
			<audio data-remote autoplay playsinline></audio>
		</div>
		<script src="/assets/js/voicemail.js" defer></script>
		<script src="/assets/js/meet.js" defer></script>
		<script src="/assets/js/recorder.js" defer></script>
		<script src="/assets/js/phone.js" defer></script>
	}
}
