# Copy to .env (never in git), then restart `task dev`. Everything is optional.

# Premium notes. Without both keys, new notes say "Notes aren't set up yet".
# For a demo, without keys: 1 writes transcripts on this machine's graphics card and
# summaries through this machine's Claude Code login. Never for paying customers.
# MINIVOIP_NOTES_LOCAL=1
# The claude program itself, if `claude` is a wrapper around it (`mise which claude`).
# MINIVOIP_NOTES_CLAUDE=
# Transcripts, from https://elevenlabs.io (speech to text):
ELEVENLABS_API_KEY=
# Summaries and next actions, from https://platform.claude.com:
ANTHROPIC_API_KEY=
# The most audio all accounts' notes can cover in a day, in hours (default 20).
# MINIVOIP_NOTES_DAY_HOURS=20

# The rest have working defaults on this machine.
# MINIVOIP_DB=data/minivoip.db
# MINIVOIP_CALL_LINE=ken
# MINIVOIP_PUSH_CONTACT=mailto:kdresdell@minipass.me
# MINIVOIP_TURN_HOST=voip.dresdell.com
# MINIVOIP_PUBLIC_IP=
# MINIVOIP_FIREBASE_DIR=data/firebase
# In a container: MINIVOIP_BIND=0.0.0.0, and its Caddy's address here:
# MINIVOIP_BIND=
# MINIVOIP_TRUSTED_PROXY=
