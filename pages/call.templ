package pages

import (
	"minivoip/layouts"
	"minivoip/lines"
	"minivoip/store"
)

// callData is what call.js needs to play the menu.
type callData struct {
	Line          string       `json:"line"`
	Owner         string       `json:"owner"`
	Greeting      string       `json:"greeting"`
	GreetingAudio string       `json:"greetingAudio,omitempty"` // owner's recording; replaces greeting + menu
	Menu          string       `json:"menu"`
	Options       []callOption `json:"options"`
}

type callOption struct {
	Key    string `json:"key"`
	Label  string `json:"label"`
	Action string `json:"action"`
	Say      string `json:"say"`
	SayAudio string `json:"sayAudio,omitempty"` // owner's recording of Say
	URL      string `json:"url,omitempty"`
}

func promptURL(name string) string {
	if name == "" {
		return ""
	}
	return "/prompt/" + name
}

func newCallData(l lines.Line) callData {
	d := callData{Line: l.Name, Owner: l.Owner, Greeting: l.Greeting, GreetingAudio: promptURL(l.GreetingAudio), Menu: l.Menu()}
	for _, o := range l.Options {
		d.Options = append(d.Options, callOption{Key: o.Key, Label: o.Label, Action: string(o.Action), Say: o.Say, SayAudio: promptURL(o.SayAudio), URL: o.URL})
	}
	return d
}

// Phone-style icons (from the proof of concept).
templ svgPhone() {
	<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 3.5h3l1.6 4-2 1.3a11 11 0 0 0 7.6 7.6l1.3-2 4 1.6v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 3 5.5a2 2 0 0 1 2-2Z"></path></svg>
}

templ svgHangup() {
	<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 14.6c4.6-4.1 12.2-4.1 16.8 0 .6.5.7 1.4.2 2l-1.3 1.6c-.4.5-1.1.6-1.7.4l-2.6-1a1.4 1.4 0 0 1-.9-1.3v-1.7a10 10 0 0 0-4.2 0v1.7c0 .6-.4 1.1-.9 1.3l-2.6 1c-.6.2-1.3.1-1.7-.4l-1.3-1.6c-.5-.6-.4-1.5.2-2Z"></path></svg>
}

templ svgMute() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a3 3 0 0 0-3 3v5a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3Z"></path><path d="M19 11a7 7 0 0 1-14 0M12 18v3"></path></svg>
}

templ svgPad() {
	<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="6" cy="5" r="1.7"></circle><circle cx="12" cy="5" r="1.7"></circle><circle cx="18" cy="5" r="1.7"></circle><circle cx="6" cy="11" r="1.7"></circle><circle cx="12" cy="11" r="1.7"></circle><circle cx="18" cy="11" r="1.7"></circle><circle cx="6" cy="17" r="1.7"></circle><circle cx="12" cy="17" r="1.7"></circle><circle cx="18" cy="17" r="1.7"></circle><circle cx="12" cy="22" r="1.7"></circle></svg>
}

templ svgPerson() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>
}

var padKeys = []struct{ Key, Letters string }{
	{"1", ""}, {"2", "ABC"}, {"3", "DEF"}, {"4", "GHI"}, {"5", "JKL"}, {"6", "MNO"},
	{"7", "PQRS"}, {"8", "TUV"}, {"9", "WXYZ"}, {"*", ""}, {"0", "+"}, {"#", ""},
}

func initial(name string) string {
	for _, r := range name {
		return string(r)
	}
	return "?"
}

// Call is the visitor's call window: /call/<line>. It looks like a phone's
// call screen (a phone-sized frame on computers). call.js runs it; data-show
// lists the call states each part appears in.
templ Call(l lines.Line) {
	@layouts.Base("Call "+l.Business, "") {
		<link rel="stylesheet" href="/assets/css/callscreen.css"/>
		<div class="cs">
			<main class="cs-stage">
				<div class="cs-screen" data-call data-state="idle">
					<header class="cs-head">
						<div class="cs-avatar" aria-hidden="true">{ initial(l.Business) }</div>
						<h1 class="cs-name">{ l.Business }</h1>
						<p class="cs-status" data-status role="status" aria-live="polite">Tap the green button to call</p>
						<p class="cs-timer" data-timer aria-hidden="true"></p>
					</header>
					<div class="cs-mid">
						<ul class="cs-choices" data-show="menu" hidden aria-label="Choices">
							for _, o := range l.Options {
								<li><button type="button" class="cs-choice" data-key={ o.Key }><b>{ o.Key }</b>{ o.Label }</button></li>
							}
						</ul>
						<div class="cs-pad" data-pad hidden role="group" aria-label="Keypad">
							for _, k := range padKeys {
								<button type="button" class="cs-key" data-key={ k.Key }>
									<b>{ k.Key }</b>
									<small>
										if k.Letters != "" {
											{ k.Letters }
										} else {
											&nbsp;
										}
									</small>
								</button>
							}
						</div>
						<div class="cs-rec" data-show="recording" hidden>
							<span class="cs-dot"></span>
							<span>Recording your message</span>
							<button type="button" class="cs-pill" data-action="send-message">Send my message</button>
						</div>
					</div>
					<div class="cs-bar is-one" data-show="idle ended">
						<button type="button" class="cs-btn is-yes is-big" data-action="call">
							@svgPhone()
							<span>Call</span>
						</button>
					</div>
					<div class="cs-bar" data-show="menu ringing connecting talking voicemail recording sending" hidden>
						<button type="button" class="cs-btn" data-action="mute" aria-pressed="false">
							@svgMute()
							<span>Mute</span>
						</button>
						<button type="button" class="cs-btn" data-action="pad" aria-pressed="false">
							@svgPad()
							<span>Keypad</span>
						</button>
						<button type="button" class="cs-btn is-no" data-action="hangup">
							@svgHangup()
							<span>Hang up</span>
						</button>
					</div>
					<p class="cs-foot">Free web call · no phone needed · <a href="/" target="_blank">minivoip</a></p>
					<audio class="cs-remote" data-remote autoplay playsinline></audio>
				</div>
			</main>
		</div>
		@templ.JSONScript("line", newCallData(l))
		<script src="/assets/js/call.js" defer></script>
	}
}

// Phone is the owner's phone app: /app. Its own dark app (no dashboard):
// the line, notifications, voicemail, log out. A call takes the whole
// screen. phone.js keeps it connected and rings.
templ Phone(l lines.Line, voicemails []store.Voicemail, vapidKey, callURL string) {
	@layouts.Base("minivoip", "") {
		<link rel="stylesheet" href="/assets/css/callscreen.css"/>
		<div class="cs dark" data-phone data-line={ l.Name } data-vapid={ vapidKey }>
			<main class="cs-app">
				<div class="cs-top">
					<img src="/assets/brand/logo-minivoip-dark.svg" alt="minivoip" width="132" height="24"/>
					<span class="cs-online"><i data-dot></i><span data-conn>Connecting…</span></span>
				</div>
				<h1 class="cs-title">{ l.Business }</h1>
				<p class="cs-sub">{ callURL }</p>
				<div class="cs-ready">
					@svgPhone()
					<div>
						<p><strong>Ready for calls</strong></p>
						<p class="cs-sub">This phone rings when a caller picks a "Ring my phone" choice.</p>
					</div>
				</div>
				<section class="cs-box" data-push>
					<h2>Ring when the app is closed</h2>
					<p data-push-state>Checking this phone…</p>
					<p class="cs-hint" data-push-ios hidden>On iPhone: tap Share, then "Add to Home Screen". Open minivoip from that icon and turn notifications on there.</p>
					<div class="cs-row">
						<button type="button" class="cs-pillbtn is-main" data-push-on hidden>Turn on notifications</button>
						<button type="button" class="cs-pillbtn" data-push-test hidden>Send a test</button>
						<button type="button" class="cs-link" data-push-off hidden>Turn off on this phone</button>
					</div>
				</section>
				<section class="cs-box">
					<h2>Voicemail</h2>
					<div data-voicemail-box>
						@VoicemailList(voicemails, "/app")
					</div>
				</section>
				<form method="post" action="/logout" class="cs-row">
					<input type="hidden" name="next" value="/app"/>
					<button type="submit" class="cs-link">Log out</button>
				</form>
			</main>
			<div class="cs-call" data-show="incoming connecting talking" hidden>
				<div class="cs-screen">
					<header class="cs-head">
						<div class="cs-avatar">
							@svgPerson()
						</div>
						<p class="cs-name">Website caller</p>
						<p class="cs-status" data-status role="status" aria-live="assertive">Incoming call…</p>
						<p class="cs-option" data-option></p>
						<p class="cs-timer" data-timer></p>
					</header>
					<div class="cs-mid"></div>
					<div class="cs-bar is-two" data-show="incoming" hidden>
						<button type="button" class="cs-btn is-no is-big" data-action="decline">
							@svgHangup()
							<span>Decline</span>
						</button>
						<button type="button" class="cs-btn is-yes is-big" data-action="accept">
							@svgPhone()
							<span>Answer</span>
						</button>
					</div>
					<div class="cs-bar is-two" data-show="connecting talking" hidden>
						<button type="button" class="cs-btn" data-action="mute" aria-pressed="false">
							@svgMute()
							<span>Mute</span>
						</button>
						<button type="button" class="cs-btn is-no" data-action="hangup" aria-label="Hang up">
							@svgHangup()
							<span>Hang up</span>
						</button>
					</div>
				</div>
			</div>
			<audio class="cs-remote" data-remote autoplay playsinline></audio>
		</div>
		<script src="/assets/js/voicemail.js" defer></script>
		<script src="/assets/js/phone.js" defer></script>
	}
}

// AppLogin is the phone app's own log in screen (the app never shows the
// website's pages).
templ AppLogin(f AccountForm) {
	@layouts.Base("minivoip", "") {
		<link rel="stylesheet" href="/assets/css/callscreen.css"/>
		<div class="cs">
			<main class="cs-app">
				<div class="cs-top">
					<img src="/assets/brand/logo-minivoip-dark.svg" alt="minivoip" width="132" height="24"/>
				</div>
				<h1 class="cs-title">Your phone app</h1>
				<p class="cs-sub">Log in with your minivoip account to receive your calls on this phone.</p>
				<form method="post" action="/login" class="cs-form">
					if f.Error != "" {
						<p class="cs-err" role="alert">{ f.Error }</p>
					}
					<input type="hidden" name="next" value={ f.Next }/>
					<label>
						Email
						<input id="email" name="email" type="email" value={ f.Email } required autocomplete="email"/>
					</label>
					<label>
						Password
						<input id="password" name="password" type="password" required autocomplete="current-password"/>
					</label>
					<button type="submit" class="cs-pillbtn is-main">Log in</button>
				</form>
				<p class="cs-hint">No account yet? Sign up on a computer at the minivoip website first.</p>
			</main>
		</div>
	}
}
