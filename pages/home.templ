package pages

import (
	"minivoip/components/badge"
	"minivoip/components/button"
	"minivoip/components/icon"
	"minivoip/layouts"
)

// The words come from docs/landing-copy.md; change them there first.

type feature struct {
	Icon  func(...icon.Props) templ.Component
	Title string
	Text  string
}

var features = []feature{
	{icon.AudioLines, "Answers every call", "Your receptionist greets callers in your own voice, day or night."},
	{icon.Split, "Sends each call to the right place", "The right person, your booking page, your price list or your opening hours. You decide what each choice does."},
	{icon.Smartphone, "Rings your cell", "Only when the call is really for you. It uses the phone you already have, with the same number."},
	{icon.Voicemail, "Takes messages", "Callers leave a voicemail and you get an alert on your phone to play it."},
	{icon.Clock, "Knows your hours", "After closing time, callers hear your after-hours message and leave a message."},
	{icon.Users, "Rings your whole team", "Add a partner's phone or your laptop. They all ring, and the first person free takes the call."},
	{icon.Globe, "Works from your website", "One Call button on your site, or a link and QR code for Google Maps, Facebook or your front door."},
	{icon.Lock, "Keeps your number private", "Callers never see your cell number, and calls are never recorded."},
	{icon.PiggyBank, "No phone line to pay", "$30 a year per line, after the free beta. No per-minute charges."},
}

// aiFeature is planned, not built: it must stay labelled "Coming soon".
var aiFeature = feature{icon.Sparkles, "AI receptionist", "Answers common questions for you, like your hours, prices and directions, and sums up your messages."}

type step struct {
	Title string
	Text  string
}

var steps = []step{
	{"Record your greeting", "Say hello and set the choices: press 1 for bookings, 2 to talk to you. Record it from your browser."},
	{"Install the app on your phone", "Open a link on your phone and add it to your home screen. Your phone number stays the same."},
	{"Add the button to your site", "Paste one line into your website. Can't edit your site? Share your call link or a QR code."},
}

type faq struct {
	Q string
	A string
}

var faqs = []faq{
	{"Can people call me from a regular phone?", "Not yet. Calls come from your website, your call link or a QR code. A real phone number is planned as an add-on."},
	{"Will my iPhone ring like a normal call?", "You get a notification with a sound, and you answer by tapping it. Apple doesn't let web apps show a full ringing screen. Android phones and computers keep ringing until you answer."},
	{"Does the caller need to install anything?", "No. They click the button and talk from their browser, after allowing the microphone."},
	{"What if I miss the call?", "After 30 seconds the caller can leave a voicemail. You get a notification and play it in the app."},
	{"I can't edit my website. Can I still use it?", "Yes. Put your call link on your Google Maps listing, your Facebook page, your email signature, or print it as a QR code for your door."},
}

var included = []string{
	"Your receptionist: greeting, choices and call routing",
	"Unlimited calls, no per-minute charges",
	"Voicemail with notifications",
	"Call link and QR code",
	"As many phones as you like",
}

// Home is the landing page; loggedIn swaps "Log in" for the dashboard link.
// callLine is a real line visitors can call to try minivoip ("" hides the
// "Call us now" buttons).
templ Home(loggedIn bool, callLine string) {
	@layouts.Base("minivoip: a virtual receptionist for your website that rings your cell", "Your website's receptionist answers every call in your voice, sends it to the right place and rings your cell when it's for you. No phone line needed. Free while in beta.") {
		@siteNav(loggedIn)
		<main>
			@hero(callLine)
			@callFlow(callLine)
			@featureList()
			@howItWorks()
			@pricing()
			@faqList()
			@finalCall()
		</main>
		@siteFooter()
		<script src="/assets/js/landing.js" defer></script>
	}
}

// brand is the mini-family logo (same bars and wordmark as minipass and
// minicrm), one artwork per theme. Only the height is set.
templ brand() {
	<a href="/" class="flex shrink-0 items-center" aria-label="minivoip home">
		<img src="/assets/brand/logo-minivoip.svg" alt="minivoip" width="132" height="24" class="h-5 w-auto sm:h-6 dark:hidden"/>
		<img src="/assets/brand/logo-minivoip-dark.svg" alt="minivoip" width="132" height="24" class="hidden h-5 w-auto sm:h-6 dark:block"/>
	</a>
}

templ siteNav(loggedIn bool) {
	<nav class="sticky top-0 z-50 border-b border-transparent bg-background/90 backdrop-blur-md">
		<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-2 px-4 sm:gap-4">
			@brand()
			<div class="hidden items-center gap-8 text-[15px] text-muted-foreground md:flex">
				<a href="#features" class="transition-colors hover:text-foreground">Features</a>
				<a href="#how" class="transition-colors hover:text-foreground">How it works</a>
				<a href="#pricing" class="transition-colors hover:text-foreground">Pricing</a>
				<a href="#faq" class="transition-colors hover:text-foreground">Questions</a>
			</div>
			<div class="flex items-center gap-0.5 sm:gap-2">
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Attributes: templ.Attributes{"data-theme-toggle": "", "aria-label": "Switch light or dark mode"}}) {
					<span class="hidden dark:block">
						@icon.Sun()
					</span>
					<span class="block dark:hidden">
						@icon.Moon()
					</span>
				}
				if loggedIn {
					@button.Button(button.Props{Href: "/dashboard", Size: button.SizeSm, Class: "h-9 rounded-lg px-4"}) {
						My dashboard
					}
				} else {
					@button.Button(button.Props{Href: "/login", Variant: button.VariantGhost, Size: button.SizeSm, Class: "h-9"}) {
						Log in
					}
					@button.Button(button.Props{Href: "/signup", Size: button.SizeSm, Class: "h-9 rounded-lg px-3 sm:px-4"}) {
						Get my free line
					}
				}
			</div>
		</div>
	</nav>
}

templ hero(callLine string) {
	<section class="mx-auto max-w-4xl px-4 pt-16 pb-14 text-center sm:pt-24 sm:pb-16">
		<h1 class="text-[2.6rem] leading-[1.05] font-semibold tracking-[-0.035em] text-balance sm:text-6xl sm:leading-[1.04] lg:text-[4rem]">
			Your website's receptionist answers every call and sends it to your cell.
		</h1>
		<p class="mx-auto mt-6 max-w-2xl text-lg/relaxed text-pretty text-muted-foreground">
			Visitors click Call on your website. Your receptionist greets them in your voice, sends each call to the right person, the right page or voicemail, and rings your cell only when it's for you. No phone line needed.
		</p>
		<div class="mt-8 flex flex-col items-stretch justify-center gap-2.5 sm:flex-row sm:items-center">
			@button.Button(button.Props{Href: "/signup", Size: button.SizeLg, Class: "h-12 rounded-xl px-6 text-[15px]"}) {
				Get my free line
				@icon.ArrowRight()
			}
			if callLine != "" {
				@button.Button(button.Props{Href: "/call/" + callLine, Target: "_blank", Variant: button.VariantOutline, Size: button.SizeLg, Class: "h-12 rounded-xl px-6 text-[15px]", Attributes: templ.Attributes{"data-call-us": ""}}) {
					@icon.Phone()
					Call us now
				}
			} else {
				@button.Button(button.Props{Href: "#demo", Variant: button.VariantOutline, Size: button.SizeLg, Class: "h-12 rounded-xl px-6 text-[15px]"}) {
					@icon.Play()
					Try the demo call
				}
			}
		</div>
		<p class="mt-5 flex flex-wrap items-center justify-center gap-x-5 gap-y-1 text-sm text-muted-foreground">
			<span class="flex items-center gap-1.5">
				@icon.Check(icon.Props{Class: "size-4 text-emerald-600"})
				Free while in beta
			</span>
			<span class="flex items-center gap-1.5">
				@icon.Check(icon.Props{Class: "size-4 text-emerald-600"})
				No card required
			</span>
		</p>
		if callLine != "" {
			<p class="mt-2 text-sm text-muted-foreground">"Call us now" is a real call, answered by our own minivoip line.</p>
		}
	</section>
}

// callFlow is the demo: a sample call drawn as its path, from the website's
// Call button to Joe's cell. At rest it shows a call to Joe; pressing Call us
// plays it (landing.js). Nothing rings and nothing is recorded.
templ callFlow(callLine string) {
	<section id="demo" class="mx-auto max-w-6xl px-4 pb-24">
		<div class="flow-canvas relative rounded-3xl border p-5 sm:p-8 lg:px-10 lg:py-9" data-flow data-state="idle">
			<svg class="flow-wires hidden lg:block" aria-hidden="true" data-wires>
				<defs>
					<linearGradient id="flow-hot" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1000" y2="0">
						<stop offset="0" stop-color="#f3840f"></stop>
						<stop offset=".55" stop-color="#e31a5a"></stop>
						<stop offset="1" stop-color="#9f1574"></stop>
					</linearGradient>
				</defs>
			</svg>
			<div class="relative grid lg:grid-cols-[minmax(0,13rem)_minmax(0,18.5rem)_minmax(0,16.5rem)_12.5rem] lg:justify-between lg:gap-x-6">
				<div class="flow-col flex flex-col">
					@flowLabel("1", "Visitor clicks Call", false)
					<div class="flex flex-1 items-center">
						<div class="flow-node w-full overflow-hidden" data-node="site">
							<div class="flex h-7 items-center gap-1.5 border-b bg-muted/50 px-3 text-[11px] text-muted-foreground">
								<span class="size-[7px] rounded-full bg-border"></span>
								<span class="size-[7px] rounded-full bg-border"></span>
								<span class="size-[7px] rounded-full bg-border"></span>
								<span class="ml-2">joesbnb.example</span>
							</div>
							<div class="grid h-24 place-items-center">
								<button type="button" data-action="call" class="inline-flex h-10 items-center gap-2 rounded-full bg-foreground px-4 text-sm font-semibold text-background shadow-[0_8px_18px_-8px_rgb(244_100_34/0.6)] transition-transform hover:scale-[1.04] focus-visible:ring-4 focus-visible:ring-ring/50 focus-visible:outline-none active:scale-[0.98]">
									@icon.Phone(icon.Props{Class: "size-4"})
									Call us
								</button>
							</div>
						</div>
					</div>
				</div>
				<div class="flow-col flex flex-col">
					@flowLabel("2", "Your greeting answers", false)
					<div class="flex flex-1 items-center">
						<div class="flow-node flex min-h-[11.5rem] w-full flex-col justify-center p-4" data-node="greet" aria-live="polite">
							<div data-when="idle greeting">
								<div class="flex items-center justify-between text-[12.5px] font-medium">
									<span class="flex items-center gap-1.5">
										@icon.AudioLines(icon.Props{Class: "size-4"})
										Greeting, in Joe's voice
									</span>
									<span class="font-normal text-muted-foreground tabular-nums">0:09</span>
								</div>
								@waveform(44, 30, 5, 0.7, "mt-3.5")
								<p class="mt-3.5 text-[14.5px]/relaxed">
									“Hi, you've reached Joe's B&amp;B. Press 1 for bookings, press 2 <span class="text-muted-foreground">to talk to Joe.”</span>
								</p>
							</div>
							<div data-when="menu" hidden class="text-center">
								<p class="text-base font-semibold">Choose an option</p>
								<p class="mt-1 text-sm text-muted-foreground">Tap one of the choices, like a caller would.</p>
							</div>
							<div data-when="book" hidden class="flex flex-col items-center gap-2 text-center">
								@icon.Globe(icon.Props{Class: "size-6"})
								<p class="font-semibold">Opening joesbnb.example/booking</p>
								<p class="text-[13px] text-muted-foreground">Choice 1 sends callers to Joe's booking page. The call ends there.</p>
							</div>
							<div data-when="hours" hidden class="text-center">
								@waveform(34, 22, 9, 1, "justify-center")
								<p class="mt-3 text-[14.5px]/relaxed">“We're open every day from 8 a.m. to 8 p.m. Thanks for calling!”</p>
								<p class="mt-1 text-[13px] text-muted-foreground">Choice 3 plays a message, then hangs up.</p>
							</div>
							<div data-when="ringing" hidden class="text-center">
								<p class="font-semibold">Ringing Joe's cell…</p>
								<p class="mt-1 text-sm text-muted-foreground tabular-nums"><span data-ring-count>0</span> s</p>
								<p class="mt-2 text-[13px] text-muted-foreground">Joe's laptop is ringing too.</p>
							</div>
							<div data-when="voicemail" hidden class="flex flex-col items-center gap-3 text-center">
								<p class="text-[14.5px]/relaxed">“Joe can't answer right now. Leave a message after the tone.”</p>
								<button type="button" data-action="record" class="inline-flex h-10 items-center gap-2 rounded-lg bg-red-600 px-4 text-sm font-semibold text-white hover:bg-red-700 focus-visible:ring-4 focus-visible:ring-red-600/30 focus-visible:outline-none">
									@icon.Mic(icon.Props{Class: "size-4"})
									Record a message
								</button>
							</div>
							<div data-when="recording" hidden class="flex flex-col items-center gap-3 text-center">
								<p class="flex items-center gap-2 font-semibold">
									<span class="rec-dot size-2.5 rounded-full bg-red-600"></span>
									Recording <span class="tabular-nums" data-rec-count>0:00</span>
								</p>
								<button type="button" data-action="send" class="inline-flex h-10 items-center rounded-lg bg-foreground px-4 text-sm font-semibold text-background hover:bg-foreground/90 focus-visible:ring-4 focus-visible:ring-ring/50 focus-visible:outline-none">
									Send message
								</button>
								<p class="text-[13px] text-muted-foreground">Nothing is really recorded.</p>
							</div>
							<div data-when="sent" hidden class="flex flex-col items-center gap-2 text-center">
								@icon.Check(icon.Props{Class: "size-6 text-emerald-600"})
								<p class="font-semibold">Message sent. Thanks for calling!</p>
								<p class="text-[13px] text-muted-foreground">Joe gets a notification right away.</p>
							</div>
							<button type="button" data-action="reset" data-when="book hours sent" hidden class="mx-auto mt-3 text-sm font-medium underline underline-offset-4 hover:text-muted-foreground">
								Start the demo again
							</button>
						</div>
					</div>
				</div>
				<div class="flow-col flex flex-col">
					@flowLabel("3", "They choose", false)
					<div class="flex flex-1 items-center">
						<div class="grid w-full gap-2.5 lg:gap-[1.1rem]">
							@flowChoice("1", "Bookings", "Opens your booking page", "book", "o1", icon.Link)
							@flowChoice("2", "Talk to Joe", "Rings Joe's cell", "ring", "o2", icon.Phone)
							@flowChoice("3", "Hours and directions", "Plays a message", "hours", "o3", icon.Clock)
							@flowChoice("0", "Leave a message", "Voicemail, with an alert", "message", "o0", icon.Voicemail)
						</div>
					</div>
				</div>
				<div class="flow-col flex flex-col">
					@flowLabel("4", "Only then, your cell rings", true)
					<div class="flex flex-1 flex-col items-center justify-center">
						<div class="[zoom:0.6]" data-node="phone">
							@joesPhone()
						</div>
						<p class="mt-3 text-center text-[13px] font-semibold">
							Joe's own cell
							<span class="block text-xs font-normal text-muted-foreground">Same phone, same number</span>
						</p>
					</div>
				</div>
			</div>
		</div>
		<p class="mt-4 text-center text-sm text-muted-foreground">A demo with a sample business. Press Call us: nothing rings and nothing is recorded.</p>
		if callLine != "" {
			<div class="mt-6 flex justify-center">
				@button.Button(button.Props{Href: "/call/" + callLine, Target: "_blank", Size: button.SizeLg, Class: "h-11 rounded-xl px-6 text-[15px]"}) {
					@icon.Phone()
					Make a real call to us
				}
			</div>
		}
	</section>
}

templ flowLabel(n, text string, strong bool) {
	<p class={ "mb-3 flex items-center gap-2 text-[13px] font-medium lg:mb-5", templ.KV("text-muted-foreground", !strong), templ.KV("font-semibold", strong) }>
		<span class={ "flex size-5 items-center justify-center rounded-md text-[11px] font-semibold", templ.KV("bg-card shadow-[inset_0_0_0_1px_var(--border)]", !strong), templ.KV("bg-foreground text-background", strong) }>{ n }</span>
		{ text }
	</p>
}

// flowChoice is one choice of Joe's menu; it can be pressed while the demo
// waits for a choice.
templ flowChoice(key, label, hint, action, node string, ic func(...icon.Props) templ.Component) {
	<button type="button" data-action={ action } data-node={ node } disabled class="flow-node flow-opt flex h-14 w-full items-center gap-3 px-3.5 text-left focus-visible:ring-4 focus-visible:ring-ring/50 focus-visible:outline-none">
		<span class="flow-key flex size-[26px] shrink-0 items-center justify-center rounded-md bg-muted text-[12.5px] font-semibold shadow-[inset_0_0_0_1px_var(--border)]">{ key }</span>
		<span class="min-w-0">
			<span class="block text-sm font-medium">{ label }</span>
			<span class="flow-sub block text-xs text-muted-foreground">{ hint }</span>
		</span>
		@ic(icon.Props{Class: "ml-auto size-4 shrink-0 text-muted-foreground"})
	</button>
}

// joesPhone is the owner's cell with the minivoip app, one screen per demo
// state.
templ joesPhone() {
	<div class="lp-phone">
		<div class="lp-screen">
			<div class="flex items-center justify-between pt-[11px] pr-[22px] pl-[26px] text-[13px] font-semibold">
				<span>9:41</span>
				<span class="flex gap-[5px]">
					@icon.Signal(icon.Props{Class: "size-[14px]"})
					@icon.Wifi(icon.Props{Class: "size-[14px]"})
					@icon.BatteryFull(icon.Props{Class: "size-[14px]"})
				</span>
			</div>
			<p class="mt-10 flex items-center justify-center gap-2 text-[12.5px] text-white/60">
				<img src="/assets/brand/icon.png" alt="" class="size-4 rounded bg-white p-px"/>
				minivoip · Joe's B&amp;B
			</p>
			<div data-when="idle ringing" class="text-center">
				<div class="lp-ring mx-auto mt-14 flex size-[86px] items-center justify-center rounded-full bg-white/10">
					@icon.Globe(icon.Props{Class: "size-9"})
				</div>
				<p class="mt-10 text-[23px] font-semibold tracking-tight">Website caller</p>
				<p class="mt-1.5 text-sm text-white/70">Pressed 2 · Talk to Joe</p>
				<p class="mt-0.5 text-xs text-white/45">from joesbnb.example</p>
				<div class="absolute inset-x-0 bottom-14 flex justify-between px-10 text-xs text-white/70">
					<span class="flex flex-col items-center gap-2.5">
						<span class="flex size-[62px] items-center justify-center rounded-full bg-red-500">
							@icon.PhoneOff(icon.Props{Class: "size-6"})
						</span>
						Decline
					</span>
					<span class="flex flex-col items-center gap-2.5">
						<span class="lp-answer flex size-[62px] items-center justify-center rounded-full bg-green-500">
							@icon.Phone(icon.Props{Class: "size-6"})
						</span>
						Answer
					</span>
				</div>
			</div>
			<div data-when="greeting menu book hours" hidden class="mt-36 px-8 text-center">
				@icon.Smartphone(icon.Props{Class: "mx-auto size-12 text-white/60"})
				<p class="mt-5 text-xl font-semibold">Waiting for calls</p>
				<p class="mt-2 text-[15px] text-white/60">Your cell stays in your pocket until a caller picks “Talk to Joe”.</p>
			</div>
			<div data-when="voicemail recording" hidden class="mt-36 px-8 text-center">
				@icon.Voicemail(icon.Props{Class: "mx-auto size-12 text-white/60"})
				<p class="mt-5 text-xl font-semibold">Missed call</p>
				<p class="mt-2 text-[15px] text-white/60">The caller is leaving a message…</p>
			</div>
			<div data-when="sent" hidden class="mx-5 mt-28 rounded-3xl bg-white/10 p-5">
				<p class="flex items-center gap-2 text-sm font-semibold">
					@icon.Voicemail(icon.Props{Class: "size-5"})
					New voicemail
				</p>
				<p class="mt-2 text-[15px] text-white/70">Website caller · <span data-rec-final>0:05</span></p>
				<p class="mt-4 text-[15px] font-semibold underline underline-offset-4">Tap to play</p>
			</div>
			<div class="absolute bottom-[9px] left-1/2 h-1 w-24 -translate-x-1/2 rounded bg-white/55"></div>
		</div>
		<div class="lp-cam"></div>
	</div>
}

templ waveform(n, height, seed int, played float64, class string) {
	<div class={ "wave flex items-center justify-between gap-[3px]", class } style={ "height:" + px(height) } aria-hidden="true">
		for _, b := range wave(n, height, seed, played) {
			<i style={ b.style() }></i>
		}
	</div>
}

templ sectionHead(title, lead string) {
	<div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
		<h2 class="max-w-xl text-[2rem] leading-[1.08] font-semibold tracking-[-0.03em] text-balance sm:text-[2.75rem]">{ title }</h2>
		if lead != "" {
			<p class="max-w-md text-base/relaxed text-muted-foreground">{ lead }</p>
		}
	</div>
}

templ featureList() {
	<section id="features" class="mx-auto max-w-6xl px-4 py-20 sm:py-24">
		@sectionHead("Everything a good receptionist does", "On the cell phone you already carry. Set it up once, and change your greeting and choices whenever you like.")
		<div class="mt-12 grid sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-3 lg:gap-x-12">
			for _, f := range features {
				@featureItem(f, false)
			}
			@featureItem(aiFeature, true)
		</div>
	</section>
}

templ featureItem(f feature, soon bool) {
	<div class="border-t py-6">
		<h3 class="flex items-center gap-2.5 font-semibold tracking-[-0.01em]">
			@f.Icon(icon.Props{Class: "size-[19px] shrink-0"})
			{ f.Title }
			if soon {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					Coming soon
				}
			}
		</h3>
		<p class="mt-2 pl-[29px] text-[15px]/relaxed text-muted-foreground">{ f.Text }</p>
	</div>
}

templ howItWorks() {
	<section id="how" class="border-t">
		<div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:py-24 lg:grid-cols-[1fr_26rem] lg:gap-20">
			<div>
				@sectionHead("Set up in three steps", "")
				<p class="mt-3 text-muted-foreground">You set it all up yourself, from your browser.</p>
				<ol class="mt-10">
					for i, s := range steps {
						<li class="grid grid-cols-[2.5rem_1fr] gap-3.5 border-t py-5">
							<span class="flex size-8 items-center justify-center rounded-lg bg-muted text-sm font-semibold shadow-[inset_0_0_0_1px_var(--border)] tabular-nums">{ stepNumber(i) }</span>
							<div class="min-w-0">
								<h3 class="text-[17px] font-semibold tracking-[-0.01em]">{ s.Title }</h3>
								<p class="mt-1 text-[15px]/relaxed text-muted-foreground">{ s.Text }</p>
								if i == 2 {
									<div class="mt-3 overflow-x-auto rounded-lg border bg-muted/40 px-3 py-2.5 font-mono text-[12.5px]">
										<code>&lt;script src="https://minivoip.example/w.js" data-line="joesbnb"&gt;&lt;/script&gt;</code>
									</div>
									<p class="mt-2 text-xs text-muted-foreground">The one line you paste into your website (example line name).</p>
								}
							</div>
						</li>
					}
				</ol>
			</div>
			<div class="flex justify-center rounded-[1.75rem] bg-muted/60 py-10">
				<div class="[zoom:0.9] sm:[zoom:1]">
					@setupPhone()
				</div>
			</div>
		</div>
	</section>
}

// setupPhone shows the owner's side in plain words: the greeting and the
// choices, as set up in the dashboard (sample line).
templ setupPhone() {
	<div class="lp-phone" aria-hidden="true">
		<div class="lp-screen lite">
			<div class="flex items-center justify-between pt-[11px] pr-[22px] pl-[26px] text-[13px] font-semibold">
				<span>9:41</span>
				<span class="flex gap-[5px]">
					@icon.Signal(icon.Props{Class: "size-[14px]"})
					@icon.Wifi(icon.Props{Class: "size-[14px]"})
					@icon.BatteryFull(icon.Props{Class: "size-[14px]"})
				</span>
			</div>
			<div class="px-4 pt-6">
				<p class="text-xl font-semibold tracking-tight">Your line</p>
				<p class="text-xs text-muted-foreground">Joe's B&amp;B · callers press Call on your site</p>
				<div class="mt-4 rounded-2xl bg-card p-3.5 shadow-[0_0_0_1px_var(--border)]">
					<p class="text-xs font-medium text-muted-foreground">Your greeting</p>
					<div class="mt-2.5 flex items-center gap-2.5">
						<span class="flex size-[30px] shrink-0 items-center justify-center rounded-full bg-foreground text-background">
							@icon.Play(icon.Props{Class: "size-3 fill-current"})
						</span>
						@waveform(36, 22, 31, 1, "flex-1 overflow-hidden gap-[2px]! [&>i]:w-[2px]!")
					</div>
					<p class="mt-2 text-[12.5px]/snug">“Hi, you've reached Joe's B&amp;B. Press 1 for bookings, press 2 to talk to Joe.”</p>
				</div>
				<div class="mt-3 rounded-2xl bg-card px-3.5 py-1.5 shadow-[0_0_0_1px_var(--border)]">
					<p class="pt-2 text-xs font-medium text-muted-foreground">Your choices</p>
					@setupChoice("1", "Bookings", "Opens a page")
					@setupChoice("2", "Talk to Joe", "Rings my phone")
					@setupChoice("0", "Message", "Voicemail")
				</div>
				<div class="mt-3 flex h-10 items-center justify-center gap-1.5 rounded-xl bg-foreground text-[13px] font-semibold text-background">
					@icon.Plus(icon.Props{Class: "size-4"})
					Add a choice
				</div>
			</div>
			<div class="absolute bottom-[9px] left-1/2 h-1 w-24 -translate-x-1/2 rounded bg-foreground/30"></div>
		</div>
		<div class="lp-cam"></div>
	</div>
}

templ setupChoice(key, label, does string) {
	<div class="flex items-center gap-2.5 border-t py-2.5 text-[13px] first-of-type:border-t-0">
		<span class="flex size-[22px] items-center justify-center rounded-md bg-muted text-[11.5px] font-semibold shadow-[inset_0_0_0_1px_var(--border)]">{ key }</span>
		<span class="font-medium">{ label }</span>
		<span class="ml-auto text-[11.5px] text-muted-foreground">{ does }</span>
	</div>
}

func stepNumber(i int) string {
	return []string{"1", "2", "3"}[i]
}

templ pricing() {
	<section id="pricing" class="border-t bg-muted/40 py-20 sm:py-24">
		<div class="mx-auto max-w-6xl px-4">
			<div class="mx-auto mb-12 max-w-2xl text-center">
				<h2 class="text-[2rem] leading-[1.08] font-semibold tracking-[-0.03em] sm:text-[2.75rem]">One line, one price</h2>
				<p class="mt-3 text-muted-foreground">About the price of a coffee a month.</p>
			</div>
			<div class="mx-auto max-w-md rounded-2xl bg-card p-8 shadow-[0_0_0_1px_var(--border),0_24px_60px_-34px_rgb(0_0_0/0.35)]">
				<div class="flex items-center justify-between">
					<h3 class="font-semibold">minivoip line</h3>
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						Beta
					}
				</div>
				<p class="mt-6 flex items-baseline gap-2">
					<span class="text-5xl font-semibold tracking-[-0.03em]">Free</span>
					<span class="text-muted-foreground">while in beta</span>
				</p>
				<p class="mt-2 text-sm text-muted-foreground">Then $30 a year per line, about $2.50 a month.</p>
				<ul class="mt-8 flex flex-col gap-3 text-sm">
					for _, item := range included {
						<li class="flex items-start gap-2.5">
							@icon.Check(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-emerald-600"})
							{ item }
						</li>
					}
				</ul>
				@button.Button(button.Props{Href: "/signup", Size: button.SizeLg, Class: "mt-8 h-12 w-full rounded-xl text-[15px]"}) {
					Get my free line
				}
				<p class="mt-4 text-center text-sm text-muted-foreground">Have a promo code? Enter it when you sign up.</p>
			</div>
		</div>
	</section>
}

templ faqList() {
	<section id="faq" class="py-20 sm:py-24">
		<div class="mx-auto max-w-3xl px-4">
			<h2 class="mb-10 text-center text-[2rem] leading-[1.08] font-semibold tracking-[-0.03em] sm:text-[2.75rem]">Questions</h2>
			<div class="divide-y border-y">
				for _, f := range faqs {
					<details class="group py-5">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium [&::-webkit-details-marker]:hidden">
							{ f.Q }
							@icon.Plus(icon.Props{Class: "size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-45"})
						</summary>
						<p class="mt-3 leading-relaxed text-muted-foreground">{ f.A }</p>
					</details>
				}
			</div>
		</div>
	</section>
}

templ finalCall() {
	<section class="px-4 pb-24">
		<div class="mx-auto flex max-w-6xl flex-col items-center gap-6 rounded-3xl bg-primary px-6 py-16 text-center text-primary-foreground">
			<h2 class="text-[2rem] leading-[1.08] font-semibold tracking-[-0.03em] text-balance sm:text-[2.75rem]">Give your website a receptionist</h2>
			<p class="max-w-xl text-primary-foreground/75">Record your greeting, install the app, paste one line. Free while in beta.</p>
			@button.Button(button.Props{Href: "/signup", Variant: button.VariantSecondary, Size: button.SizeLg, Class: "h-12 rounded-xl px-6 text-[15px]"}) {
				Get my free line
			}
		</div>
	</section>
}

templ siteFooter() {
	<footer class="border-t py-10">
		<div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 text-sm text-muted-foreground sm:flex-row">
			<div class="flex items-center gap-3">
				@brand()
				<span>Part of the mini family, with minipass and minicrm.</span>
			</div>
			<a href="mailto:kdresdell@minipass.me" class="underline-offset-4 hover:text-foreground hover:underline">kdresdell@minipass.me</a>
		</div>
	</footer>
}
