package pages

import (
	"strconv"

	"minivoip/components/button"
	"minivoip/components/icon"
	"minivoip/components/input"
	"minivoip/layouts"
	"minivoip/lines"
	"minivoip/store"
)

// LineForm is the "create your line" form shown back after an error.
type LineForm struct {
	Business string
	Name     string // the call link's last part; suggested from Business
	Custom   bool   // show the link field open (an error, or the owner changed it)
	Host     string // this site's address, for the link preview
	Error    string
}

// dashShell is the logged-in frame (DESIGN.md "Dashboard"): a menu on the
// left with the phone app and the account at its foot; on a phone a top bar
// and tabs at the bottom, like an app. Pages sit on light grey in white
// cards. They need no component scripts (layouts.Lean); the account menu is
// a native popover.
templ dashShell(title, email, current string) {
	@layouts.Lean(title+" · minivoip", "") {
		<link rel="stylesheet" href="/assets/css/fonts.css"/>
		<div class="dash min-h-dvh md:grid md:grid-cols-[248px_minmax(0,1fr)]">
			<header class="sticky top-0 z-40 flex h-14 items-center justify-between border-b bg-background pr-2 pl-4 md:hidden">
				@brand()
				<button type="button" popovertarget="account-menu" class="grid size-11 place-items-center rounded-full" aria-label="Your account" data-account-button>
					@avatar(email)
				</button>
			</header>
			<aside class="sticky top-0 hidden h-dvh flex-col border-r bg-background px-3.5 pt-5 pb-4 md:flex">
				<div class="px-2.5">
					@brand()
				</div>
				<nav aria-label="Dashboard" class="mt-5 flex flex-col gap-0.5">
					@sideTab("/dashboard", "Home", current, 0) {
						@icon.House(icon.Props{Class: "size-[18px]"})
					}
					@sideTab("/dashboard/menu", "What callers hear", current, 0) {
						@icon.AudioLines(icon.Props{Class: "size-[18px]"})
					}
					@sideTab("/dashboard/voicemail", "Messages", current, newMessages(ctx)) {
						@icon.Voicemail(icon.Props{Class: "size-[18px]"})
					}
					@sideTab(notesTab, "Notes", current, 0) {
						@icon.NotebookText(icon.Props{Class: "size-[18px]"})
					}
					@sideTab("/dashboard/business", "Business", current, 0) {
						@icon.Store(icon.Props{Class: "size-[18px]"})
					}
				</nav>
				<div class="mt-auto flex flex-col gap-1.5">
					<a href="/app" data-phone-window class="focus-inset flex items-center gap-3 rounded-xl p-2.5 shadow-[inset_0_0_0_1px_var(--border)] hover:bg-muted">
						<span class="grid size-9 flex-none place-items-center rounded-[10px] bg-muted">
							@icon.Smartphone(icon.Props{Class: "size-[18px]"})
						</span>
						<span class="min-w-0 flex-1">
							<span class="block font-medium">Phone app</span>
							<span class="block text-xs text-muted-foreground">Get it on your phone</span>
						</span>
						@icon.QrCode(icon.Props{Class: "size-[18px] flex-none text-muted-foreground"})
					</a>
					<button type="button" popovertarget="account-menu" class="focus-inset flex items-center gap-2.5 rounded-xl p-2.5 text-left hover:bg-muted" data-account-button>
						@avatar(email)
						<span class="min-w-0 flex-1">
							<span class="block text-[13px] font-semibold">Your account</span>
							<span class="block truncate text-xs text-muted-foreground">{ email }</span>
						</span>
						@icon.ChevronsUpDown(icon.Props{Class: "size-4 flex-none text-muted-foreground"})
					</button>
				</div>
			</aside>
			<div class="flex min-w-0 flex-col">
				<main class="mx-auto w-full max-w-[1060px] flex-1 px-4 pt-5 pb-10 sm:px-6 md:px-10 md:pt-9">
					{ children... }
				</main>
				<footer class="mx-auto w-full max-w-[1060px] px-4 pb-28 text-sm text-muted-foreground sm:px-6 md:px-10 md:pb-8">
					Questions? <a href="mailto:kdresdell@minipass.me" class="underline underline-offset-4 hover:text-foreground">kdresdell@minipass.me</a>
				</footer>
			</div>
			<nav aria-label="Dashboard" class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-5 border-t bg-background px-1.5 pt-1.5 max-[359px]:px-0 pb-[max(0.5rem,env(safe-area-inset-bottom))] md:hidden">
				@bottomTab("/dashboard", "Home", current, 0) {
					@icon.House(icon.Props{Class: "size-[22px]"})
				}
				@bottomTab("/dashboard/menu", "Callers hear", current, 0) {
					@icon.AudioLines(icon.Props{Class: "size-[22px]"})
				}
				@bottomTab("/dashboard/voicemail", "Messages", current, newMessages(ctx)) {
					@icon.Voicemail(icon.Props{Class: "size-[22px]"})
				}
				@bottomTab(notesTab, "Notes", current, 0) {
					@icon.NotebookText(icon.Props{Class: "size-[22px]"})
				}
				@bottomTab("/dashboard/business", "Business", current, 0) {
					@icon.Store(icon.Props{Class: "size-[22px]"})
				}
			</nav>
			@accountMenu(email)
			@phoneSheet(email)
		</div>
		<script src="/assets/js/phonewindow.js" defer></script>
	}
}

// sideTab is one line of the left menu; the open page is shaded.
templ sideTab(href, text, current string, count int) {
	<a
		href={ templ.SafeURL(href) }
		class={ "focus-inset flex items-center gap-3 rounded-[10px] px-2.5 py-2.5 font-medium",
			templ.KV("bg-muted text-foreground", href == current),
			templ.KV("text-muted-foreground hover:bg-muted hover:text-foreground", href != current) }
		if href == current {
			aria-current="page"
		}
	>
		{ children... }
		{ text }
		if count > 0 {
			@countBadge(count, "ml-auto")
		}
		if href == notesTab && onBasic(ctx) {
			@premiumTag("ml-auto")
		}
	</a>
}

// bottomTab is one of the phone's tabs at the bottom of the screen.
templ bottomTab(href, text, current string, count int) {
	<a
		href={ templ.SafeURL(href) }
		class={ "focus-inset relative flex min-h-12 flex-col items-center justify-center gap-1 rounded-lg text-[11.5px] font-medium whitespace-nowrap max-[359px]:text-[10.5px]",
			templ.KV("text-foreground", href == current),
			templ.KV("text-muted-foreground", href != current) }
		if href == current {
			aria-current="page"
		}
	>
		{ children... }
		{ text }
		if count > 0 {
			@countBadge(count, "absolute top-0 left-[calc(50%+4px)]")
		}
	</a>
}

// premiumTag marks what Basic owners don't have yet. Callers never see it.
templ premiumTag(class string) {
	<span class={ "rounded-full bg-foreground px-2 py-0.5 text-xs font-semibold text-background", class } data-premium-tag>Premium</span>
}

// countBadge is the orange number of new messages.
templ countBadge(count int, class string) {
	<span class={ "grid h-[18px] min-w-[18px] place-items-center rounded-full bg-[#c2410c] px-1.5 text-[11px] font-semibold text-white tabular-nums", class } data-tab-count>{ strconv.Itoa(count) }<span class="sr-only">new</span></span>
}

// avatar is the account's round letter.
templ avatar(email string) {
	<span class="grid size-9 flex-none place-items-center rounded-full bg-foreground text-sm font-semibold text-background" aria-hidden="true">{ firstLetter(email) }</span>
}

// accountMenu opens from the account button: who is logged in, the phone
// app, minivoip's own admin for staff, and Log out. Esc or a click outside
// closes it. It sits under the phone's top bar, or above the left menu's foot.
templ accountMenu(email string) {
	<div id="account-menu" popover class="fixed inset-auto m-0 w-72 max-w-[calc(100vw-2rem)] rounded-xl border-0 bg-background p-1.5 text-[15px] text-foreground shadow-[0_0_0_1px_var(--border),0_18px_50px_-20px_rgb(0_0_0/0.35)] max-md:top-[3.25rem] max-md:right-4 md:bottom-[4.75rem] md:left-3.5">
		<div class="px-3 pt-2 pb-3">
			<p class="text-[13px] text-muted-foreground">Logged in as</p>
			<p class="truncate font-medium" data-account-email>{ email }</p>
		</div>
		<div class="flex flex-col border-t pt-1.5">
			<a href="/dashboard/password" class={ menuItem }>
				@icon.KeyRound(icon.Props{Class: "size-4 text-muted-foreground"})
				Change password
			</a>
			<a href="/dashboard/language" class={ menuItem }>
				@icon.Languages(icon.Props{Class: "size-4 text-muted-foreground"})
				Language of your notes
			</a>
			<a href="/app" data-phone-window class={ menuItem }>
				@icon.Smartphone(icon.Props{Class: "size-4 text-muted-foreground"})
				Phone app
			</a>
			if isAdmin(ctx) {
				<a href="/admin/promo" class={ menuItem }>
					@icon.ShieldCheck(icon.Props{Class: "size-4 text-muted-foreground"})
					minivoip admin
				</a>
			}
			<form method="post" action="/logout">
				<button type="submit" class={ menuItem }>
					@icon.LogOut(icon.Props{Class: "size-4 text-muted-foreground"})
					Log out
				</button>
			</form>
		</div>
	</div>
}

const menuItem = "focus-inset flex w-full items-center gap-2.5 rounded-lg px-3 py-2.5 text-left hover:bg-muted"

templ panel() {
	<section class="rounded-2xl border bg-background p-6 sm:p-8">
		{ children... }
	</section>
}

// NewLine is step 2 of sign up: the business name, which also makes the
// call link (dashboard.js shows it as you type; "Change" edits it).
templ NewLine(email string, f LineForm) {
	@accountShell("Your business") {
		@stepLabel("Step 2 of 2: your business")
		<h1 class="text-2xl font-bold tracking-tight">What's your business called?</h1>
		<p class="mt-1 text-sm text-muted-foreground">Callers see and hear this name, beside your logo.</p>
		<form method="post" action="/dashboard/line" enctype="multipart/form-data" class="mt-6 flex flex-col gap-5" data-new-line>
			@formError(f.Error)
			@formField("business", "Business name") {
				@input.Input(input.Props{Class: fieldClass, ID: "business", Name: "business", Value: f.Business, Required: true, Placeholder: "Joe's B&B", Attributes: templ.Attributes{"autofocus": "", "autocomplete": "organization", "data-business": ""}})
			}
			<div class="rounded-xl border bg-muted/40 p-4">
				<p class="text-xs font-medium text-muted-foreground">Your call link</p>
				<p class="mt-1 font-mono text-sm break-all">{ f.Host }/call/<span class="font-semibold" data-link-preview>{ previewName(f) }</span></p>
				<p class="mt-2 text-xs text-muted-foreground">Share it, print it as a QR code, or put it behind a Call button on your website. We make it from your business name.</p>
				<button
					type="button"
					class="mt-2 text-xs font-medium underline underline-offset-4"
					data-link-edit
					if f.Custom {
						hidden
					}
				>Change it</button>
				<div
					class="mt-3"
					if !f.Custom {
						hidden
					}
					data-link-field
				>
					@formField("name", "Link name") {
						@input.Input(input.Props{Class: fieldClass, ID: "name", Name: "name", Value: customName(f), Placeholder: "joes-bnb", Attributes: templ.Attributes{"autocomplete": "off", "autocapitalize": "none", "pattern": "[a-z0-9][a-z0-9\\-]{1,28}[a-z0-9]"}})
						<p class="text-xs text-muted-foreground">3 to 30 lowercase letters, numbers or dashes. It can't change later.</p>
					}
				</div>
			</div>
			@formField("logo", "Your logo (optional)") {
				<div class="flex items-center gap-3">
					<img data-logo-preview hidden alt="Your logo, framed" class="size-14 flex-none rounded-xl bg-white object-cover"/>
					@logoPicker("logo", "Choose a picture", false, false)
				</div>
				<p class="text-sm text-destructive" data-logo-error hidden role="alert"></p>
				<p class="text-xs text-muted-foreground">{ logoHint }</p>
			}
			@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg, Class: "h-10 w-full"}) {
				Create my line
			}
		</form>
		<form method="post" action="/logout" class="mt-6 text-center text-sm text-muted-foreground">
			Signed in as { email }.
			<button type="submit" class="font-medium text-foreground underline underline-offset-4">Log out</button>
		</form>
		@logoCrop()
		<script src="/assets/js/dashboard.js" defer></script>
	}
}

func previewName(f LineForm) string {
	if f.Name != "" {
		return f.Name
	}
	if f.Business != "" {
		return lines.Suggest(f.Business)
	}
	return "your-business"
}

func customName(f LineForm) string {
	if f.Custom {
		return f.Name
	}
	return ""
}

const logoAccept = "image/png,image/jpeg,image/webp"
const logoHint = "Callers see it when they call you and in your meeting room. Pick a PNG, JPG or WebP picture; you frame it next."

// logoCrop is the window where the owner frames the logo they picked
// (assets/js/logo.js, with Cropper.js, which it loads on the first pick).
templ logoCrop() {
	<style>[data-logo-crop] .cropper-view-box { outline: 2px solid #fff; outline-color: #fff; } [data-logo-crop] .cropper-line, [data-logo-crop] .cropper-point { display: none; } [data-logo-crop] .cropper-view-box, [data-logo-crop] .cropper-face { border-radius: 50%; }</style>
	<dialog data-logo-crop aria-labelledby="logo-crop-title" class="m-auto w-[min(26rem,calc(100vw-2rem))] overflow-hidden rounded-2xl border bg-background p-0 text-foreground shadow-2xl backdrop:bg-black/50">
		<div class="px-5 pt-5">
			<h2 id="logo-crop-title" class="font-semibold">Frame your logo</h2>
			<p class="mt-1 text-sm text-muted-foreground">Drag to move it, zoom to fit. The circle is what callers see.</p>
		</div>
		<div class="mt-4 h-80 bg-muted">
			<img data-logo-crop-img alt="" class="block max-w-full"/>
		</div>
		<div class="flex items-center gap-2 px-5 pt-4">
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon, Attributes: templ.Attributes{"data-crop": "out", "aria-label": "Zoom out"}}) {
				@icon.ZoomOut()
			}
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeIcon, Attributes: templ.Attributes{"data-crop": "in", "aria-label": "Zoom in"}}) {
				@icon.ZoomIn()
			}
			@button.Button(button.Props{Variant: button.VariantOutline, Attributes: templ.Attributes{"data-crop": "fit"}}) {
				@icon.Scan()
				Whole logo
			}
		</div>
		<div class="flex justify-end gap-2 p-5">
			@button.Button(button.Props{Variant: button.VariantGhost, Attributes: templ.Attributes{"data-crop": "cancel"}}) {
				Cancel
			}
			@button.Button(button.Props{Attributes: templ.Attributes{"data-crop": "use"}}) {
				Use this logo
			}
		</div>
	</dialog>
	<script src="/assets/js/logo.js" defer></script>
}

// tap makes the dashboard's buttons thumb-sized (44px) on a phone.
const tap = "max-sm:h-11"

// shownValue is a link or a line of code to copy, shown whole: it wraps
// instead of hiding its end in a one-line box. Copy buttons read data-value.
templ shownValue(id, value string) {
	<p id={ id } data-value={ value } class="min-w-0 flex-1 rounded-lg bg-muted px-3 py-2 font-mono text-sm leading-relaxed [overflow-wrap:anywhere]">{ value }</p>
}

// copyButton copies the value (data-value) of the element with this id; a
// check mark and the page's status line (copyStatus) say it worked.
templ copyButton(id, label, class string, primary bool) {
	@button.Button(button.Props{Variant: copyVariant(primary), Class: tap + " " + class, Attributes: templ.Attributes{"data-copy": id}}) {
		@icon.Copy(icon.Props{Attributes: templ.Attributes{"data-copy-icon": ""}})
		@icon.Check(icon.Props{Attributes: templ.Attributes{"data-copied-icon": "", "hidden": ""}})
		<span data-copy-label>{ label }</span>
	}
}

func copyVariant(primary bool) button.Variant {
	if primary {
		return button.VariantDefault
	}
	return button.VariantOutline
}

// copyStatus is read out by screen readers when something is copied.
templ copyStatus() {
	<p class="sr-only" role="status" data-copy-status></p>
}

// logoPicker is one button that opens the owner's pictures; logo.js then
// opens the crop window. The file field itself stays hidden.
templ logoPicker(id, text string, submit bool, required bool) {
	<input
		type="file"
		id={ id }
		name="logo"
		accept={ logoAccept }
		required?={ required }
		class="sr-only"
		tabindex="-1"
		aria-hidden="true"
		data-logo-input
		if submit {
			data-logo-submit
		}
	/>
	@button.Button(button.Props{Variant: button.VariantOutline, Class: "self-start " + tap, Attributes: templ.Attributes{"data-logo-pick": id}}) {
		@icon.ImageUp()
		{ text }
	}
}

// dashBadge is the business's logo (or initials) on the dashboard.
templ dashBadge(l lines.Line, size string) {
	if l.Logo != "" {
		<span class={ "grid flex-none place-items-center overflow-hidden rounded-2xl bg-white", size } data-logo-badge><img src={ logoURL(l) } alt={ l.Business + " logo" } class="size-full object-cover"/></span>
	} else {
		<span class={ "grid flex-none place-items-center rounded-2xl bg-foreground font-semibold text-background", size } aria-hidden="true">{ initials(l.Business) }</span>
	}
}

// businessNote says what just happened on the Business tab (?note=).
func businessNote(msg string) (text string, bad bool) {
	switch msg {
	case "named":
		return "Saved. Callers see the new name right away.", false
	case "noname":
		return "Write your business name.", true
	case "saved":
		return "Saved. Callers see your new logo right away.", false
	case "removed":
		return "Removed. Callers see your initials instead.", false
	case "bad":
		return "That file can't be a logo. Use a PNG, JPG or WebP picture of 2 MB or less.", true
	}
	return "", false
}

// pill makes the Home tab's buttons round, as in DESIGN.md "Dashboard".
const pill = "rounded-full px-4 " + tap

// card is a white card on the dashboard's grey.
const card = "rounded-2xl bg-card p-5 shadow-[0_0_0_1px_var(--border)] sm:p-6"

// Dashboard is the Home tab: the next setup step, the line (is it on, its
// link), where to put it and the latest calls. Anything technical (the
// website code) opens in a window only when the owner picks it.
templ Dashboard(h HomeTab) {
	{{ l := h.Line }}
	{{ left, next := nextStep(h.steps()) }}
	@dashShell("Home", h.Email, "/dashboard") {
		<h1 class="text-[22px] font-semibold tracking-[-0.025em] md:text-[26px]">Home</h1>
		if left > 0 {
			@setupBand(left, next)
		}
		<div class="mt-5 grid gap-5 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]">
			<section class={ card + " lg:col-span-2" } aria-label="Your line">
				<div class="flex items-center gap-3.5">
					@dashBadge(l, "size-14 text-lg")
					<div class="min-w-0">
						<p class="lp-display text-xl leading-tight font-semibold tracking-[-0.02em] text-balance">{ l.Business }</p>
						@lineStatus(h)
					</div>
				</div>
				<div class="mt-5 flex flex-col gap-4 border-t pt-5 sm:flex-row sm:items-end sm:justify-between sm:gap-6">
					<div class="min-w-0">
						<p class="text-[13px] font-medium text-muted-foreground">Your call link</p>
						<p id="call-link" data-value={ h.callURL() } class="lp-display mt-0.5 text-xl leading-snug font-medium tracking-[-0.02em] [overflow-wrap:anywhere]"><span class="text-muted-foreground">{ h.hostName() }/call/</span>{ l.Name }</p>
					</div>
					<div class="flex gap-2.5 sm:flex-none max-sm:[&>*]:flex-1">
						@copyButton("call-link", "Copy link", pill, true)
						@button.Button(button.Props{Href: h.callURL(), Target: "_blank", Variant: button.VariantOutline, Class: pill}) {
							@icon.Phone()
							Try it
						}
					</div>
				</div>
			</section>
			@hearCard(l)
			<section class={ card } aria-labelledby="share-title">
				<h2 id="share-title" class="text-[17px] font-semibold tracking-[-0.015em]">Share your line</h2>
				<p class="text-sm text-muted-foreground">Where do you want people to call you from?</p>
				<ul class="mt-3 -mb-2">
					@shareRow("dlg-website", "On your website", "A Call button in the corner of every page", "Set it up", icon.Globe(icon.Props{Class: "size-[18px]"}))
					@shareRow("dlg-email", "In your emails", "A \"Call us\" line for your signature", "Get the line", icon.Mail(icon.Props{Class: "size-[18px]"}))
					if l.Premium {
						@shareRow("dlg-room", "Video meetings", "Your own meeting room, with a link to send", "Open", icon.Video(icon.Props{Class: "size-[18px]"}))
					} else {
						@shareRow("dlg-room", "Video meetings", "Your own meeting room comes with Premium", "See what it does", icon.Video(icon.Props{Class: "size-[18px]"}))
					}
				</ul>
			</section>
			<div class={ card }>
				@latestCalls(h.Latest)
			</div>
		</div>
		@websiteSheet(h)
		@sheet("dlg-email", "A line for your emails") {
			<p class="mt-2 text-muted-foreground">Put it in your email signature. People click it and talk to you from their browser.</p>
			<div class="mt-5 flex flex-col gap-2 sm:flex-row sm:items-start">
				@shownValue("email-line", "Call us: "+h.callURL())
				@copyButton("email-line", "Copy", "", false)
			</div>
			<p class="mt-5 text-sm text-muted-foreground">Gmail: Settings, See all settings, Signature. Outlook: Settings, Mail, Compose and reply.</p>
		}
		@roomSheet(h)
		@copyStatus()
		<script src="/assets/js/dashboard.js" defer></script>
	}
}

// lineStatus is the line under the business name: a green dot when calls
// ring the owner, amber otherwise.
templ lineStatus(h HomeTab) {
	{{ text, on := h.status() }}
	<p
		class="mt-1 flex items-start gap-2 text-[15px] text-muted-foreground"
		data-line-status
		data-on?={ on }
	>
		<span class={ "mt-[0.45em] size-2 flex-none rounded-full", templ.KV("bg-[#16a34a] shadow-[0_0_0_3px_rgb(22_163_74/0.16)]", on), templ.KV("bg-[#d97706] shadow-[0_0_0_3px_rgb(217_119_6/0.16)]", !on) }></span>
		{ text }
	</p>
}

// shareRow is one place to put the call link; the whole row opens its window.
templ shareRow(open, title, hint, action string, ic templ.Component) {
	<li class="border-t">
		<button type="button" data-open={ open } class="focus-inset group flex w-full items-center gap-3.5 py-3.5 text-left">
			<span class="grid size-10 flex-none place-items-center rounded-xl bg-muted">
				@ic
			</span>
			<span class="min-w-0 flex-1">
				<span class="block font-semibold">{ title }</span>
				<span class="block text-[13px] text-muted-foreground">{ hint }</span>
			</span>
			<span class="flex-none rounded-full px-3.5 py-1.5 text-[13px] font-semibold shadow-[inset_0_0_0_1px_var(--border)] group-hover:bg-muted max-sm:hidden">{ action }</span>
			@icon.ChevronRight(icon.Props{Class: "size-4 flex-none text-muted-foreground sm:hidden"})
		</button>
	</li>
}

// stepButton does what a setup step asks: opens its window or its page.
templ stepButton(s setupStep, class string) {
	if s.Open != "" {
		@button.Button(button.Props{Class: class, Attributes: templ.Attributes{"data-open": s.Open}}) {
			{ s.Action }
		}
	} else {
		@button.Button(button.Props{Href: s.Href, Class: class}) {
			{ s.Action }
		}
	}
}

// setupBand is the next setup step, in peach at the top of Home, ticked from
// what the line really has (a menu of its own, a phone that gets
// notifications, a logo). It goes away once all three are done.
templ setupBand(left int, next setupStep) {
	<div class="mt-4 flex flex-col gap-3 rounded-2xl bg-[#fff4ec] p-4 shadow-[inset_0_0_0_1px_#ffd9c4] sm:flex-row sm:items-center sm:gap-5 sm:px-5 dark:bg-[#2a1a12] dark:shadow-[inset_0_0_0_1px_#4a2a1c]" data-setup-band>
		<div class="min-w-0 flex-1">
			<p class="font-semibold">{ stepsLeftText(left, next) }</p>
			<p class="mt-0.5 text-sm text-muted-foreground">{ next.Hint }</p>
		</div>
		@stepButton(next, pill+" sm:flex-none max-sm:w-full")
	</div>
}

// latestCalls is the last three calls and voicemails (the phone app's list).
templ latestCalls(list []store.HistoryEntry) {
	<section aria-labelledby="latest-title">
		<h2 id="latest-title" class="text-[17px] font-semibold tracking-[-0.015em]">Latest calls</h2>
		if len(list) == 0 {
			<p class="mt-3 border-t pt-3.5 text-sm text-muted-foreground" data-latest>No calls yet. Press Try it to hear what your callers hear.</p>
		} else {
			<ul class="mt-3" data-latest>
				for _, e := range list {
					<li class="flex items-center gap-3 border-t py-3">
						<span
							class={ "grid size-9 flex-none place-items-center rounded-full",
							templ.KV("bg-foreground text-background", e.Voicemail != nil && !e.Voicemail.Listened),
							templ.KV("bg-muted", e.Voicemail == nil || e.Voicemail.Listened),
							templ.KV("text-[#d33a2c]", entryKind(e) == "missed") }
						>
							switch entryKind(e) {
								case "voicemail":
									@icon.Voicemail(icon.Props{Class: "size-4"})
								case "answered":
									@icon.PhoneIncoming(icon.Props{Class: "size-4"})
								default:
									@icon.PhoneMissed(icon.Props{Class: "size-4"})
							}
						</span>
						<div class="min-w-0 flex-1">
							<p class="font-semibold">
								{ entryTitle(e) }
								if n := entryLength(e); n != "" {
									<span class="font-normal text-muted-foreground tabular-nums">· { n }</span>
								}
							</p>
							if e.Option != "" {
								<p class="truncate text-[13px] text-muted-foreground">Chose { e.Option }</p>
							}
						</div>
						<span class="text-[13px] whitespace-nowrap text-muted-foreground tabular-nums">{ latestWhen(e.At) }</span>
					</li>
				}
			</ul>
		}
		<a href="/dashboard/voicemail" class="mt-2 inline-flex min-h-11 items-center font-semibold underline decoration-border underline-offset-4 hover:decoration-foreground">Your messages</a>
	</section>
}

// sheet is a window over the dashboard (a native dialog: dashboard.js opens
// it from data-open; Esc, Close or a click outside close it). On a phone it
// rises from the bottom.
templ sheet(id, title string) {
	<dialog id={ id } aria-labelledby={ id + "-title" } data-sheet class="m-auto max-h-[calc(100dvh-2rem)] w-[min(36rem,calc(100vw-2rem))] max-w-none overflow-y-auto rounded-2xl bg-background p-0 text-foreground shadow-[0_0_0_1px_var(--border),0_24px_70px_-30px_rgb(0_0_0/0.5)] backdrop:bg-black/40 max-sm:mb-0 max-sm:max-h-[calc(100dvh-3rem)] max-sm:w-full max-sm:rounded-b-none">
		<div class="p-6 max-sm:pb-9">
			<div class="flex items-start justify-between gap-4">
				<h2 id={ id + "-title" } class="pt-1 text-xl font-semibold tracking-[-0.02em]">{ title }</h2>
				<form method="dialog">
					<button type="submit" class="-mt-1 -mr-2 grid size-11 flex-none place-items-center rounded-full text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Close">
						@icon.X(icon.Props{Class: "size-5"})
					</button>
				</form>
			</div>
			{ children... }
		</div>
	</dialog>
}

// websiteSheet is the Call button for the owner's website: copy one line,
// paste it, with where to paste it on the common website builders.
templ websiteSheet(h HomeTab) {
	{{ snippet := `<script src="` + h.Host + `/w.js" data-line="` + h.Line.Name + `" async></script>` }}
	@sheet("dlg-website", "A Call button on your website") {
		<p class="mt-2 text-muted-foreground">A button shows in the corner of every page. It says "Talk to us now" when you're available, "Leave us a message" when you're not.</p>
		<ol class="mt-6 flex flex-col gap-6">
			<li>
				<p class="font-semibold">1. Copy this code</p>
				<div class="mt-2.5 flex flex-col gap-2 sm:flex-row sm:items-start">
					<p id="button-code" data-value={ snippet } class="min-w-0 flex-1 rounded-lg bg-muted px-3 py-2 font-mono text-[13px] leading-relaxed [overflow-wrap:anywhere]">
						{ `<script src="` + h.Host + `/w.js" data-line="` }<mark class="rounded-sm bg-[var(--now)] px-0.5 text-foreground">{ h.Line.Name }</mark>{ `" async></script>` }
					</p>
					@copyButton("button-code", "Copy", "", false)
				</div>
			</li>
			<li>
				<p class="font-semibold">2. Paste it into your website</p>
				<p class="mt-1 text-sm text-muted-foreground">At the end of every page, just before <code class="font-mono text-xs">&lt;/body&gt;</code>. Where to find that:</p>
				<dl class="mt-3 grid grid-cols-[6.5rem_1fr] gap-x-3 gap-y-2 text-sm">
					<dt class="font-semibold">Wix</dt>
					<dd class="text-muted-foreground">Settings, Custom code, "Body - end"</dd>
					<dt class="font-semibold">Squarespace</dt>
					<dd class="text-muted-foreground">Code injection, in the Footer box</dd>
					<dt class="font-semibold">WordPress</dt>
					<dd class="text-muted-foreground">A plugin like WPCode, in the Footer</dd>
					<dt class="font-semibold">Shopify</dt>
					<dd class="text-muted-foreground">Themes, Edit code, theme.liquid</dd>
				</dl>
			</li>
		</ol>
		<p class="mt-6 rounded-xl bg-muted px-4 py-3 text-sm">Someone else looks after your website? Send them the code: it's all they need.</p>
	}
}

// roomSheet is the meeting room: its link on Premium, what it does on Basic.
templ roomSheet(h HomeTab) {
	@sheet("dlg-room", "Your meeting room") {
		if h.Line.Premium {
			<p class="mt-2 text-muted-foreground">Video meetings with voice, cameras, screen sharing and a whiteboard. Send the link: people join from their browser, with nothing to install, and wait until you open the room.</p>
			<div class="mt-5 flex flex-col gap-2 sm:flex-row sm:items-start">
				@shownValue("room-link", h.roomURL())
				@copyButton("room-link", "Copy", "", false)
			</div>
			@button.Button(button.Props{Href: h.roomURL(), Target: "_blank", Class: "mt-5 " + pill}) {
				@icon.Video()
				Open the room
			}
		} else {
			<p class="mt-2 text-muted-foreground" data-room-locked>
				@premiumTag("mr-1")
				Your own room for video meetings, plus a camera, screen sharing and a whiteboard in your calls. You're on Basic; Premium opens after the beta.
			</p>
		}
	}
}

// latestApp ends a sentence about what the app's address gives.
func latestApp(version string) string {
	if version == "" {
		return "the latest app."
	}
	return "the latest app, version " + version + "."
}

// phoneSheet is how to get the phone app, on every dashboard page: a QR code for
// Android on a computer, a button on a phone. The code's address always serves the
// latest app.
templ phoneSheet(email string) {
	{{ version := appVersion(ctx) }}
	@sheet("dlg-phone", "Get the phone app") {
		<div class="mt-5 hidden items-center gap-6 sm:flex">
			<div class="w-[168px] flex-none" data-phone-qr>
				<img src="/qr/android.svg" width="168" height="168" alt="QR code to download the Android app" class="block size-full rounded-2xl shadow-[0_0_0_1px_var(--border)]"/>
			</div>
			<div>
				<p class="font-semibold">Android</p>
				<p class="mt-1 text-muted-foreground" data-phone-words>{ "Scan this with your phone's camera. You always get " + latestApp(version) }</p>
				<p class="mt-2 text-sm text-muted-foreground">Your phone may ask you to allow the install.</p>
			</div>
		</div>
		<div class="sm:hidden">
			<p class="mt-2 text-muted-foreground">{ "You get " + latestApp(version) + " Your phone may ask you to allow the install." }</p>
			@button.Button(button.Props{Href: "/download/minivoip.apk", Class: "mt-4 w-full " + pill, Attributes: templ.Attributes{"data-phone-download": ""}}) {
				Download for Android
			}
		</div>
		<div class="mt-5 border-t pt-5">
			<p class="font-semibold">{ "iPhone" }<span class="max-sm:hidden">{ " or computer" }</span></p>
			<p class="mt-1 text-muted-foreground">
				Nothing to install.
				<a href="/app" class="font-medium text-foreground underline underline-offset-4" data-phone-web>Open the web app</a><span class="max-sm:hidden wrap-anywhere">{ ", or go to " + viewer(ctx).Host + "/app on your iPhone" }</span>.
			</p>
			<p class="mt-5 text-sm text-muted-foreground">Then log in with { email } and turn on notifications.</p>
		</div>
	}
}

// Business is the Business tab: the logo, the name, the call link and the plan.
// Password is "Change password", from the account menu: it also logs out the
// account's other devices.
templ Password(email, problem string, saved bool) {
	@dashShell("Change password", email, "") {
		<div class="max-w-md">
			<h1 class="text-[22px] font-semibold tracking-[-0.025em] md:text-[26px]">Change password</h1>
			<p class="mt-2 text-muted-foreground">Your other phones and computers will be logged out. They ring again once you log in on them.</p>
			if saved {
				<p class="mt-6 rounded-lg bg-muted px-3 py-2 text-sm" role="status" data-password-saved>Your password is changed.</p>
			}
			<form method="post" action="/dashboard/password" class="mt-6 flex flex-col gap-4">
				@formError(problem)
				@formField("current", "Current password") {
					@input.Input(input.Props{Class: fieldClass, ID: "current", Name: "current", Type: "password", Required: true, Attributes: templ.Attributes{"autocomplete": "current-password"}})
				}
				@formField("new", "New password") {
					@input.Input(input.Props{Class: fieldClass, ID: "new", Name: "new", Type: "password", Required: true, Attributes: templ.Attributes{"autocomplete": "new-password", "minlength": "8", "maxlength": "72"}})
					<p class="text-xs text-muted-foreground">8 to 72 characters.</p>
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg, Class: "mt-2 h-10 w-full"}) {
					Change password
				}
			</form>
		</div>
	}
}

// Language is "Language of your notes", from the account menu.
templ Language(email string, current store.Language, problem string, saved bool) {
	@dashShell("Language of your notes", email, "") {
		<div class="max-w-md">
			<h1 class="text-[22px] font-semibold tracking-[-0.025em] md:text-[26px]">Language of your notes</h1>
			<p class="mt-2 text-muted-foreground">Premium writes the summary and the next actions of your calls in this language. What people said stays in the words they used, and this site stays in English.</p>
			if saved {
				<p class="mt-6 rounded-lg bg-muted px-3 py-2 text-sm" role="status" data-language-saved>Your language is saved.</p>
			}
			<form method="post" action="/dashboard/language" class="mt-6 flex flex-col gap-4">
				@formError(problem)
				@languageChoice("Write my notes in", current)
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg, Class: "mt-2 h-10 w-full"}) {
					Save
				}
			</form>
		</div>
	}
}

templ Business(email string, l lines.Line, callURL, plan, note string) {
	@dashShell("Business", email, "/dashboard/business") {
		<div class="max-w-3xl">
			<h1 class="text-[22px] font-semibold tracking-[-0.025em] md:text-[26px]">Your business</h1>
			<p class="mt-2 text-muted-foreground">What your callers see.</p>
			if text, bad := businessNote(note); bad {
				<div class="mt-6">
					@formError(text)
				</div>
			} else if text != "" {
				<p class="mt-6 rounded-lg border border-emerald-600/30 bg-emerald-600/10 px-3 py-2 text-sm text-emerald-700 dark:text-emerald-400" role="status">{ text }</p>
			}
			<dl class={ card + " mt-6 py-0 sm:py-0" }>
				<div id="logo" class="grid gap-x-4 gap-y-3 py-6 sm:grid-cols-[11rem_minmax(0,1fr)]">
					<dt class="font-semibold">Logo</dt>
					<dd class="flex flex-col gap-4 sm:flex-row sm:items-start">
						@dashBadge(l, "size-20 text-2xl")
						<div class="flex min-w-0 flex-1 flex-col gap-2">
							<form method="post" action="/dashboard/logo" enctype="multipart/form-data" class="flex flex-col" data-logo-form>
								if l.Logo != "" {
									@logoPicker("logo-file", "Change logo", true, true)
								} else {
									@logoPicker("logo-file", "Add my logo", true, true)
								}
							</form>
							<p class="text-sm text-destructive" data-logo-error hidden role="alert"></p>
							<p class="text-sm text-muted-foreground">{ logoHint }</p>
							if l.Logo != "" {
								<form method="post" action="/dashboard/logo/remove">
									<button type="submit" class="text-sm font-medium text-muted-foreground underline underline-offset-4 hover:text-foreground">Remove the logo</button>
								</form>
							}
						</div>
					</dd>
				</div>
				<div class="grid gap-x-4 gap-y-1 border-t py-6 sm:grid-cols-[11rem_minmax(0,1fr)]">
					<dt class="font-semibold">Name</dt>
					<dd>
						<form method="post" action="/dashboard/business" class="flex flex-col gap-2 sm:flex-row sm:items-center" data-business-form>
							@input.Input(input.Props{ID: "business", Name: "business", Value: l.Business, Required: true, Class: "h-10", Attributes: templ.Attributes{"aria-label": "Business name", "autocomplete": "organization"}})
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Class: "h-10 flex-none " + pill}) {
								Save
							}
						</form>
						<p class="mt-2 text-sm text-muted-foreground">Callers see it on the call page and hear "Ringing { l.Business }".</p>
					</dd>
				</div>
				<div class="grid gap-x-4 gap-y-1 border-t py-6 sm:grid-cols-[11rem_minmax(0,1fr)]">
					<dt class="font-semibold">Call link</dt>
					<dd>
						<p class="[overflow-wrap:anywhere]">{ callURL }</p>
						<p class="mt-1 text-sm text-muted-foreground">It never changes, so the places you put it keep working.</p>
					</dd>
				</div>
				<div class="grid gap-x-4 gap-y-1 border-t py-6 sm:grid-cols-[11rem_minmax(0,1fr)]">
					<dt class="font-semibold">Plan</dt>
					<dd>
						<p data-plan>{ plan }</p>
						if !l.Premium {
							<p class="mt-1 text-sm text-muted-foreground">Premium adds video in your calls, screen sharing, a whiteboard and your own meeting room. It opens after the beta.</p>
						}
					</dd>
				</div>
			</dl>
		</div>
		@logoCrop()
		<script src="/assets/js/dashboard.js" defer></script>
	}
}

// selectClass matches the input component's look for a native select.
const selectClass = "h-9 w-full rounded-lg border border-input bg-transparent px-2.5 text-sm outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 dark:bg-input/30"

// MenuEditor is the "What callers hear" tab (hearForm).
templ MenuEditor(email string, l lines.Line) {
	@dashShell("What callers hear", email, "/dashboard/menu") {
		<link rel="stylesheet" href="/assets/css/hear.css"/>
		<div class="max-w-3xl">
			@hearForm(l, false)
		</div>
	}
}
