package pages

import (
	"strings"
	"unicode"

	"minivoip/layouts"
	"minivoip/lines"
)

// callData is what call.js needs to play the menu.
type callData struct {
	Line          string       `json:"line"`
	Business      string       `json:"business"`
	Owner         string       `json:"owner"`
	Greeting      string       `json:"greeting"`
	GreetingAudio string       `json:"greetingAudio,omitempty"` // owner's recording; replaces greeting + menu
	Menu          string       `json:"menu"`
	Options       []callOption `json:"options"`
	RingSeconds   int          `json:"ringSeconds"` // the owner's phones ring this long, then voicemail
	OwnerInitials string       `json:"ownerInitials"` // the owner's face on the stage until their camera is on
}

type callOption struct {
	Key      string `json:"key"`
	Label    string `json:"label"`
	Action   string `json:"action"`
	Say      string `json:"say"`
	SayAudio string `json:"sayAudio,omitempty"` // owner's recording of Say
	URL      string `json:"url,omitempty"`
}

func promptURL(name string) string {
	if name == "" {
		return ""
	}
	return "/prompt/" + name
}

func newCallData(l lines.Line, ringSeconds int) callData {
	d := callData{Line: l.Name, Business: l.Business, Owner: ownerName(l), Greeting: l.Greeting,
		GreetingAudio: promptURL(l.GreetingAudio), Menu: l.Menu(), RingSeconds: ringSeconds, OwnerInitials: initials(ownerName(l))}
	for _, o := range l.Options {
		d.Options = append(d.Options, callOption{Key: o.Key, Label: o.Label, Action: string(o.Action), Say: o.Say, SayAudio: promptURL(o.SayAudio), URL: o.URL})
	}
	return d
}

// ownerName is who answers: the line's owner, else its business.
func ownerName(l lines.Line) string {
	if l.Owner != "" {
		return l.Owner
	}
	return l.Business
}

// initials are the business's face until it has a logo: the first letters
// of its first two words, skipping little ones ("Auberge des Pins" is "AP").
func initials(name string) string {
	var out []rune
	for _, w := range strings.Fields(name) {
		if len(out) == 2 {
			break
		}
		r := []rune(w)
		if !unicode.IsLetter(r[0]) && !unicode.IsDigit(r[0]) || littleWords[strings.ToLower(w)] {
			continue
		}
		out = append(out, unicode.ToUpper(r[0]))
	}
	if len(out) == 0 {
		return "?"
	}
	return string(out)
}

var littleWords = map[string]bool{"de": true, "des": true, "du": true, "la": true, "le": true, "les": true,
	"the": true, "of": true, "and": true, "et": true}

// choiceHint says in a few words what a choice does.
func choiceHint(o lines.Option) string {
	switch o.Action {
	case lines.Ring:
		return "Live call"
	case lines.Play:
		return "Hear the answer"
	case lines.Link:
		return "Opens a page"
	case lines.Voicemail:
		return "Up to 2 minutes"
	}
	return ""
}

// ringsOwner reports whether a choice of the line rings the owner.
func ringsOwner(l lines.Line) bool {
	for _, o := range l.Options {
		if o.Action == lines.Ring {
			return true
		}
	}
	return false
}

templ iconPhone() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h3.5l1.7 4.2-2.1 1.3a11 11 0 0 0 5.4 5.4l1.3-2.1L19 14.5V18a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z"></path></svg>
}

templ iconHangup() {
	<svg class="cw-hangup-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h3.5l1.7 4.2-2.1 1.3a11 11 0 0 0 5.4 5.4l1.3-2.1L19 14.5V18a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z"></path></svg>
}

templ iconMic() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a3 3 0 0 0-3 3v5a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3Z"></path><path d="M19 11a7 7 0 0 1-14 0M12 18v3"></path></svg>
}

templ iconCamera() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="6" width="13" height="12" rx="2.5"></rect><path d="m15.5 10.5 6-3.5v10l-6-3.5"></path></svg>
}

templ iconScreen() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4" width="19" height="13" rx="2.5"></rect><path d="M8 21h8M12 17v4M9 10.5l3-3 3 3M12 7.5v6"></path></svg>
}

templ iconBoard() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19.2 8.8a2.8 2.8 0 0 0-4-4L4 16v4Z"></path><path d="m13.5 6.5 4 4"></path></svg>
}

templ iconBack() {
	<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
}

// callHead is the top of the window while a call is on.
templ callHead(l lines.Line, status string, attrs templ.Attributes) {
	<header class="cw-head">
		<span class="cw-badge" aria-hidden="true">{ initials(l.Business) }</span>
		<div>
			<p class="cw-head-name" tabindex="-1" data-focus>{ l.Business }</p>
			<p class="cw-head-status" { attrs... }>{ status }</p>
		</div>
	</header>
}

templ callFoot() {
	<p class="cw-foot">Free call by <a href="/" target="_blank" rel="noopener">minivoip</a></p>
}

// Call is the visitor's call window: /call/<line>, look A (DESIGN.md "Call
// window"). One view per call state; call.js shows the view whose data-show
// lists the state, writes out what the voice says, and runs the call.
templ Call(l lines.Line, ringSeconds int) {
	{{ owner := ownerName(l) }}
	@layouts.Plain("Call " + l.Business) {
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@500..700&family=Funnel+Sans:wght@400..600&display=swap"/>
		<link rel="stylesheet" href="/assets/css/callscreen.css"/>
		<link rel="stylesheet" href="/assets/css/stage.css"/>
		<main class="cw">
			<div class="cw-screen" data-call data-state="idle">
				<p class="cw-sr" data-status role="status" aria-live="polite"></p>
				<section class="cw-view" data-show="idle" aria-label={ "Call " + l.Business }>
					<div class="cw-top">
						<a class="cw-icon-btn" data-back hidden aria-label="Back to the website">
							@iconBack()
						</a>
					</div>
					<div class="cw-center">
						<span class="cw-badge is-xl" aria-hidden="true">{ initials(l.Business) }</span>
						<h1 class="cw-title" tabindex="-1" data-focus>{ l.Business }</h1>
					</div>
					<button type="button" class="cw-dial" data-action="call">
						<span class="cw-dial-btn">
							@iconPhone()
						</span>
						<span class="cw-dial-label">Call us</span>
					</button>
					<p class="cw-note">
						Free call from your browser.
						if ringsOwner(l) {
							Before you talk to { owner }, your browser will ask to use your microphone.
						}
					</p>
					@callFoot()
				</section>
				<section class="cw-view" data-show="menu" hidden aria-label="Menu">
					@callHead(l, "Playing the menu", templ.Attributes{"data-menu-status": true})
					<div class="cw-stage">
						<div class="cw-wave" data-wave aria-hidden="true">
							for _, b := range voiceWave(30, 7, 1) {
								<i style={ b.style() }></i>
							}
						</div>
						<p class="cw-words" data-words></p>
					</div>
					<ul class="cw-choices" aria-label="Choices">
						for _, o := range l.Options {
							<li>
								<button type="button" class="cw-choice" data-key={ o.Key }>
									<b>{ o.Key }</b>
									<span>{ o.Label }</span>
									if h := choiceHint(o); h != "" {
										<small>{ h }</small>
									}
								</button>
							</li>
						}
					</ul>
					<div class="cw-help" data-mic-help hidden role="alert">
						<p>Your browser blocked the microphone, so { owner } can't hear you.</p>
						<p>To allow it, tap the lock or settings icon next to the web address, then Microphone. On an iPhone: tap aA, then Website Settings.</p>
						<button type="button" class="cw-link-btn" data-action="retry-mic">Try again</button>
					</div>
					<button type="button" class="cw-btn is-quiet" data-action="hangup">
						@iconHangup()
						Hang up
					</button>
				</section>
				<section class="cw-view" data-show="ringing connecting" hidden aria-label="Ringing">
					<div class="cw-center">
						<div class="cw-rings">
							<span class="cw-badge is-round" aria-hidden="true">{ initials(owner) }</span>
						</div>
						<h2 class="cw-title" tabindex="-1" data-focus data-ring-title>Ringing { owner }…</h2>
						<p class="cw-muted" data-ring-choice></p>
					</div>
					<div class="cw-box" data-ring-box>
						<p>If { owner } can't answer, you can leave a message in <b data-ring-count></b>.</p>
						<button type="button" class="cw-link-btn" data-action="leave-message">Leave a message now</button>
					</div>
					<div class="cw-round-row">
						<button type="button" class="cw-round is-end" data-action="hangup">
							<span>
								@iconHangup()
							</span>
							<span>Hang up</span>
						</button>
					</div>
				</section>
				<section class="cw-view" data-show="talking" hidden aria-label="On the call">
					<header class="cw-head cw-talk-head">
						<span class="cw-badge" aria-hidden="true">{ initials(owner) }</span>
						<div>
							<p class="cw-head-name">On the line with { owner }</p>
							<p class="cw-head-status" data-timer aria-hidden="true">0:00</p>
						</div>
					</header>
					<div class="cw-center">
						<span class="cw-badge is-round" aria-hidden="true">{ initials(owner) }</span>
						<h2 class="cw-title" tabindex="-1" data-focus>On the line with { owner }</h2>
						<p class="cw-timer" data-timer aria-hidden="true">0:00</p>
						<div class="cw-live" data-live aria-hidden="true">
							for _, b := range voiceWave(26, 11, 1) {
								<i style={ b.style() }></i>
							}
						</div>
					</div>
					<div class="cw-stage" data-stage></div>
					<p class="cw-meet-note" data-meet-note role="status" hidden></p>
					<div class="cw-round-row is-meet">
						<button type="button" class="cw-round" data-action="mute" aria-pressed="false">
							<span>
								@iconMic()
							</span>
							<span>Mute</span>
						</button>
						<button type="button" class="cw-round" data-action="camera" aria-pressed="false">
							<span>
								@iconCamera()
							</span>
							<span>Camera</span>
						</button>
						<button type="button" class="cw-round" data-action="screen" aria-pressed="false" data-share-btn hidden>
							<span>
								@iconScreen()
							</span>
							<span>Screen</span>
						</button>
						<button type="button" class="cw-round" data-action="board" aria-pressed="false">
							<span>
								@iconBoard()
							</span>
							<span>Whiteboard</span>
						</button>
						<button type="button" class="cw-round is-end" data-action="hangup">
							<span>
								@iconHangup()
							</span>
							<span>Hang up</span>
						</button>
					</div>
				</section>
				<section class="cw-view" data-show="voicemail recording sending" hidden aria-label="Leave a message">
					<div class="cw-vm">
						<div>
							<h2 class="cw-title" tabindex="-1" data-focus>Leave a message for { owner }</h2>
							<p class="cw-words" data-vm-words></p>
						</div>
						<div class="cw-rec">
							<div class="cw-rec-top">
								<span class="cw-dot" aria-hidden="true"></span>
								<span data-rec-state>Recording starts after the tone</span>
								<span data-rec-time>2:00</span>
							</div>
							<div class="cw-wave is-small" data-rec-wave aria-hidden="true">
								for _, b := range voiceWave(34, 13, 1) {
									<i style={ b.style() }></i>
								}
							</div>
							<div class="cw-meter" aria-hidden="true"><span data-rec-bar></span></div>
						</div>
						<p class="cw-rec-tip">Say your name and phone number so { owner } can call you back.</p>
					</div>
					<button type="button" class="cw-btn is-primary" data-action="send-message" disabled>Send my message</button>
					<button type="button" class="cw-btn is-plain" data-action="restart-message" disabled>Start over</button>
				</section>
				<section class="cw-view" data-show="ended" hidden data-end-kind="ended" aria-label="Call ended">
					<div class="cw-center">
						<span class="cw-badge is-round" aria-hidden="true">
							<svg class="cw-done-icon is-sent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg>
							<svg class="cw-done-icon is-ended" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h3.5l1.7 4.2-2.1 1.3a11 11 0 0 0 5.4 5.4l1.3-2.1L19 14.5V18a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z"></path></svg>
							<svg class="cw-done-icon is-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg>
							<svg class="cw-done-icon is-unsent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v6M12 17h.01"></path></svg>
						</span>
						<h2 class="cw-title" tabindex="-1" data-focus data-end-title>Call ended</h2>
						<p class="cw-text" data-end-text></p>
					</div>
					<div class="cw-end-actions">
						<a class="cw-btn is-primary" data-end-link hidden target="_blank" rel="noopener">Open the page</a>
						<button type="button" class="cw-btn is-primary" data-action="retry-send" hidden>Try sending again</button>
						<a class="cw-btn is-primary" data-back hidden>Back to the website</a>
						<button type="button" class="cw-btn is-plain" data-action="call">Call again</button>
					</div>
					@callFoot()
				</section>
				<audio class="cw-remote" data-remote autoplay playsinline></audio>
			</div>
		</main>
		@templ.JSONScript("line", newCallData(l, ringSeconds))
		<script src="/assets/js/meet.js" defer></script>
		<script src="/assets/js/call.js" defer></script>
	}
}

// AppLogin is the app's own log in screen (the app never shows the
// website's pages). Same look as the app (app.css).
templ AppLogin(f AccountForm) {
	@layouts.Base("minivoip", "") {
		<link rel="stylesheet" href="/assets/css/app.css"/>
		<div class="ap ap-login" data-app-login>
			<main class="ap-login-in">
				<img src="/assets/brand/logo-minivoip.svg" alt="minivoip" width="121" height="22"/>
				<h1>Log in to your app</h1>
				<p class="ap-muted">Answer your website's calls on this phone or computer.</p>
				<form method="post" action="/login" class="ap-card ap-form">
					if f.Error != "" {
						<p class="ap-err" role="alert">{ f.Error }</p>
					}
					<input type="hidden" name="next" value={ f.Next }/>
					<label for="email">Email</label>
					<input id="email" name="email" type="email" value={ f.Email } required autocomplete="email"/>
					<label for="password">Password</label>
					<input id="password" name="password" type="password" required autocomplete="current-password"/>
					<button type="submit" class="ap-btn is-ink">Log in</button>
				</form>
				<p class="ap-note">No account yet? Sign up on a computer at the minivoip website first.</p>
			</main>
		</div>
	}
}
