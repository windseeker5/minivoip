package pages

import (
	"minivoip/components/button"
	"minivoip/components/icon"
	"minivoip/layouts"
)

// The words come from docs/landing-copy.md; change them there first.

// stage is one step of "the call grows": what the visitor does, what
// minivoip does for it, and the plan that has it.
type stage struct {
	Title string
	Text  string
	Plan  string
	Soon  bool
}

var stages = []stage{
	{"They ask.", "Your menu answers the easy questions. Hours, prices, directions, or a link to the right page of your site. In your own voice.", "Basic", false},
	{"They talk.", "A real customer reaches you. Your phone or computer rings. Busy? They leave a voicemail.", "Basic", false},
	{"They see.", "Turn on video, share your screen or open the whiteboard. The demo happens while they're still interested.", "Premium · coming soon", true},
}

type plan struct {
	Name    string
	Price   string
	Line    string
	Items   []string
	Premium bool
}

var plans = []plan{
	{"Basic", "$2", "Your website answers the phone for you.", []string{
		"Call button, call link and QR code",
		"Voice menu in your own voice",
		"Sends callers to the right page of your site",
		"Rings your phone and your computer",
		"Voicemail with an alert",
	}, false},
	{"Premium", "$5", "From a question to a live demo, in one click.", []string{
		"Everything in Basic",
		"AI front desk that answers from your FAQ",
		"Video and screen sharing",
		"Whiteboard to draw together",
		"A meeting room for your team, no time limit",
	}, true},
}

type step struct {
	Title string
	Text  string
}

var steps = []step{
	{"Record your menu", "Say hello and set the choices, right from your browser."},
	{"Get the app", "The Android app rings like a real call. On a computer or an iPhone, use the web app."},
	{"Add the button", "Paste one line on your site, or share your call link and QR code."},
}

type faq struct {
	Q string
	A string
}

var faqs = []faq{
	{"Can people call me from a regular phone?", "Not yet. Calls come from your website, your call link or a QR code. A real phone number is planned as an add-on."},
	{"Will my phone ring like a normal call?", "On Android, yes: the minivoip app rings with your ringtone and shows the call screen, even when your phone is locked. Computers ring while the app is open. On iPhone, for now you get a notification with a sound and answer by tapping it; a ringing iPhone app is next."},
	{"Does the visitor need to install anything?", "No. They click the button and talk from their browser, after allowing the microphone."},
	{"I can't edit my website. Can I still use it?", "Yes. Put your call link on your Google Maps listing, your Facebook page, your email signature, or print it as a QR code for your door."},
}

// Home is the landing page; loggedIn swaps "Log in" for the dashboard link.
// callLine is minivoip's own line: "Call us now" reaches Ken for a demo
// ("" hides those buttons).
templ Home(loggedIn bool, callLine string) {
	@layouts.Base("minivoip: from a question on your website to a real conversation", "minivoip puts a Call button on your website. Your voice menu answers the common questions, and when a visitor wants more, you talk to them and show them your screen, in one click. No phone line, nothing to install.") {
		<div class="lp min-h-screen bg-background text-foreground">
			@siteNav(loggedIn)
			<main>
				@hero(callLine)
				@callGrows()
				@pricing()
				@maker()
				@howItWorks()
				@faqList()
			</main>
			@finalCall(callLine)
		</div>
		<script src="/assets/js/landing.js" defer></script>
	}
}

// brand is the mini-family logo (same bars and wordmark as minipass and
// minicrm), one artwork per theme. Only the height is set.
templ brand() {
	<a href="/" class="flex min-h-11 shrink-0 items-center" aria-label="minivoip home">
		<img src="/assets/brand/logo-minivoip.svg" alt="minivoip" width="132" height="24" class="h-5 w-auto sm:h-[22px] dark:hidden"/>
		<img src="/assets/brand/logo-minivoip-dark.svg" alt="minivoip" width="132" height="24" class="hidden h-5 w-auto sm:h-[22px] dark:block"/>
	</a>
}

templ siteNav(loggedIn bool) {
	<nav class="sticky top-0 z-50 border-b bg-background">
		<div class="mx-auto flex h-14 max-w-[1080px] items-center justify-between gap-2 px-4 sm:gap-4 sm:px-6">
			@brand()
			<div class="hidden items-center gap-8 text-[13px] text-foreground/80 md:flex">
				<a href="#how" class="transition-colors hover:text-foreground">How it works</a>
				<a href="#pricing" class="transition-colors hover:text-foreground">Plans</a>
				<a href="#faq" class="transition-colors hover:text-foreground">Questions</a>
			</div>
			<div class="flex items-center gap-1 sm:gap-3">
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Class: "size-11 rounded-full text-muted-foreground", Attributes: templ.Attributes{"data-theme-toggle": "", "aria-label": "Switch light or dark mode"}}) {
					<span class="hidden dark:block">
						@icon.Sun()
					</span>
					<span class="block dark:hidden">
						@icon.Moon()
					</span>
				}
				if loggedIn {
					@button.Button(button.Props{Href: "/dashboard", Size: button.SizeSm, Class: "h-11 rounded-full px-4 text-[13px] sm:h-8"}) {
						My dashboard
					}
				} else {
					<a href="/login" class="hidden min-h-11 items-center px-2 text-[13px] text-foreground/80 transition-colors hover:text-foreground sm:flex">Log in</a>
					@button.Button(button.Props{Href: "/signup", Size: button.SizeSm, Class: "h-11 rounded-full px-4 text-[13px] sm:h-8"}) {
						Get my free line
					}
				}
			</div>
		</div>
	</nav>
}

templ hero(callLine string) {
	<section class="overflow-hidden px-4 pt-14 pb-14 text-center sm:px-6 sm:pt-20 sm:pb-20 lg:pt-[88px] lg:pb-24">
		<h1 class="mx-auto max-w-[980px] text-[2.75rem] leading-[1.04] font-semibold tracking-[-0.035em] text-balance sm:text-6xl lg:text-[4.75rem] lg:leading-[1.03]">
			From a question on your website to a real conversation, <span class="text-[var(--soft)]">in one click.</span>
		</h1>
		<p class="mx-auto mt-6 max-w-[640px] text-lg/relaxed text-pretty text-muted-foreground sm:text-[21px]/[1.45]">
			Your voice menu answers the common questions. When a visitor wants more, you talk to them and show them your screen. No phone line, nothing to install.
		</p>
		<div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-7">
			@button.Button(button.Props{Href: "/signup", Size: button.SizeLg, Class: "h-12 rounded-full px-6 text-[17px] font-medium"}) {
				Get my free line
			}
			if callLine != "" {
				<a href={ templ.SafeURL("/call/" + callLine) } target="_blank" data-call-us class="inline-flex min-h-12 items-center gap-1 px-2 text-[17px] font-medium text-primary underline-offset-4 hover:underline">
					Call us now
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				</a>
			} else {
				<a href="#how" class="inline-flex min-h-12 items-center gap-1 px-2 text-[17px] font-medium text-primary underline-offset-4 hover:underline">
					See how it works
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				</a>
			}
		</div>
		<p class="mt-4 text-[13px] text-muted-foreground">
			Free while in beta · No card required
			if callLine != "" {
				<span class="block sm:inline"><span class="hidden sm:inline"> · </span>“Call us now” rings Ken, who builds it.</span>
			}
		</p>
		@callPair()
	</section>
}

// callPair is a picture of one call from both ends: the visitor hearing the
// voice menu in their browser, and the owner's phone ringing with the choice
// they made. Nothing in it is a control.
templ callPair() {
	<div class="mx-auto mt-14 flex justify-center sm:mt-[72px] sm:gap-14" role="img" aria-label="One minivoip call from both ends: the visitor hears the voice menu and presses 1, Book a demo; the owner's phone rings with that choice">
		<figure class="lp-dev">
			<div class="lp-screen lp-visitor" aria-hidden="true">
				<div class="mx-auto grid size-[72px] place-items-center rounded-full border border-[#f3840f] text-3xl font-semibold text-[#f3840f]">m</div>
				<p class="mt-4 text-center text-[22px] font-semibold tracking-[-0.01em]">minivoip</p>
				<p class="mt-1.5 text-center text-[13px] text-[#a1a1aa]">Hi, this is Ken. Press a number…</p>
				@waveform(44, 34, 11, 0.62, "mx-auto my-6 w-[220px]")
				<div class="flex flex-col gap-1">
					<span class="lp-opt lp-opt-on"><b>1</b>Book a demo</span>
					<span class="lp-opt"><b>2</b>How it works and prices</span>
					<span class="lp-opt"><b>0</b>Leave a message</span>
				</div>
				<p class="absolute inset-x-0 bottom-6 text-center text-[11px] text-[#8a8a93]">Free web call · nothing to install</p>
			</div>
			<figcaption>Your visitor, in their browser</figcaption>
		</figure>
		<figure class="lp-dev">
			<div class="lp-screen lp-owner" aria-hidden="true">
				<p class="flex items-center gap-2 text-[13px] text-[#424245]">
					<span class="size-2 rounded-full bg-[#1f9d55] shadow-[0_0_0_4px_#dcf2e4]"></span>
					Incoming call · <span class="tabular-nums">0:04</span>
				</p>
				<p class="mt-[22px] text-[30px] leading-[1.08] font-semibold tracking-[-0.03em]">
					Someone chose
					<span class="block text-[#c9461a]">“Book a demo”</span>
				</p>
				<p class="mt-3 text-[13.5px]/[1.45] text-[#6e6e73]">A visitor on your website heard your greeting and picked this choice.</p>
				<p class="mt-[18px] rounded-[14px] px-3.5 py-3 text-[12.5px] text-[#6e6e73] shadow-[inset_0_0_0_1px_#e5e5ea]">If nobody answers: <b class="font-semibold text-[#1d1d1f]">voicemail in <span class="tabular-nums">0:26</span></b></p>
				<div class="absolute inset-x-[22px] bottom-[26px] flex flex-col gap-2">
					<span class="rounded-[14px] bg-[#157a3f] p-[15px] text-center text-base font-semibold text-white">Answer</span>
					<span class="rounded-[14px] p-3 text-center text-sm font-medium text-[#b4321f] shadow-[inset_0_0_0_1px_#e5e5ea]">Decline</span>
				</div>
			</div>
			<figcaption>You, on your own phone</figcaption>
		</figure>
	</div>
}

templ waveform(n, height, seed int, played float64, class string) {
	<div class={ "wave flex items-center justify-between gap-[2px]", class } style={ "height:" + px(height) } aria-hidden="true">
		for _, b := range wave(n, height, seed, played) {
			<i style={ b.style() }></i>
		}
	</div>
}

templ sectionHead(title, lead string) {
	<div class="mx-auto max-w-[820px] text-center">
		<h2 class="text-[2.25rem] leading-[1.06] font-semibold tracking-[-0.03em] text-balance sm:text-[3.5rem]">{ title }</h2>
		if lead != "" {
			<p class="mx-auto mt-5 max-w-[620px] text-lg/relaxed text-pretty text-muted-foreground sm:text-[21px]/[1.45]">{ lead }</p>
		}
	</div>
}

// callGrows tells the story in three steps: answers, then the owner, then
// the owner's screen. The last one is Premium.
templ callGrows() {
	<section id="how" class="scroll-mt-14 bg-[var(--band)] px-4 py-20 sm:px-6 sm:py-[120px]">
		<div class="mx-auto max-w-[1080px]">
			@sectionHead("One click, and the call grows with the question.", "Most visitors only need an answer. Some need you. A few need to see it. minivoip handles all three in the same call.")
			<div class="mt-12 grid gap-9 sm:mt-20 md:grid-cols-3 md:gap-12">
				for _, s := range stages {
					<div class="flex flex-col border-t border-[var(--rule)] pt-7">
						<h3 class="text-[2rem] font-semibold tracking-[-0.025em]">{ s.Title }</h3>
						<p class="mt-3 text-[17px]/[1.5] text-muted-foreground">{ s.Text }</p>
						<p class={ "mt-auto pt-[18px] text-[13px] font-medium", templ.KV("text-muted-foreground", s.Soon) }>{ s.Plan }</p>
					</div>
				}
			</div>
		</div>
	</section>
}

templ pricing() {
	<section id="pricing" class="scroll-mt-14 px-4 py-20 sm:px-6 sm:py-[120px]">
		<div class="mx-auto max-w-[1080px]">
			@sectionHead("Start with Basic. Grow into Premium.", "Free while in beta. No per‑minute charges.")
			<div class="mx-auto mt-12 grid max-w-[880px] gap-5 sm:mt-16 md:grid-cols-2">
				for _, p := range plans {
					@planCard(p)
				}
			</div>
			<p class="mt-8 text-center text-sm text-muted-foreground">Have a promo code? Enter it when you sign up.</p>
		</div>
	</section>
}

templ planCard(p plan) {
	<div class="flex flex-col rounded-2xl bg-card p-7 shadow-[0_0_0_1px_var(--border)] sm:p-9">
		<div class="flex items-baseline justify-between gap-3">
			<h3 class="text-xl font-semibold tracking-[-0.01em]">{ p.Name }</h3>
			if p.Premium {
				<span class="text-[13px] font-medium text-muted-foreground">Coming soon</span>
			} else {
				<span class="text-[13px] font-medium text-muted-foreground">Free in beta</span>
			}
		</div>
		<p class="mt-6 flex items-baseline gap-2">
			<span class="text-5xl font-semibold tracking-[-0.03em]">{ p.Price }</span>
			<span class="text-muted-foreground">/ month after beta, planned</span>
		</p>
		<p class="mt-2 text-[17px]">{ p.Line }</p>
		<ul class="mt-7 mb-8 flex flex-col border-b text-[15px]">
			for _, item := range p.Items {
				<li class="flex items-start gap-3 border-t py-3">
					@icon.Check(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-foreground"})
					{ item }
				</li>
			}
		</ul>
		if p.Premium {
			@button.Button(button.Props{Href: "mailto:kdresdell@minipass.me?subject=minivoip%20Premium", Variant: button.VariantOutline, Size: button.SizeLg, Class: "mt-auto h-12 w-full rounded-full text-[15px] font-medium"}) {
				Tell me when it's ready
			}
		} else {
			@button.Button(button.Props{Href: "/signup", Size: button.SizeLg, Class: "mt-auto h-12 w-full rounded-full text-[15px] font-medium"}) {
				Get my free line
			}
		}
	</div>
}

// maker is Ken's own reason for minivoip: he uses it on his businesses first.
templ maker() {
	<section class="bg-[var(--band)] px-4 py-20 sm:px-6 sm:py-[120px]">
		<figure class="mx-auto max-w-[860px] text-center">
			<blockquote class="text-[1.6rem] leading-[1.3] font-semibold tracking-[-0.025em] text-balance sm:text-[2.5rem] sm:leading-[1.2]">
				“I built minivoip for my own businesses first. A visitor on my site asks a question, and a minute later I'm showing them the product.”
			</blockquote>
			<figcaption class="mt-8 text-[15px]">
				<span class="font-semibold">Ken Dresdell</span>
				<span class="text-muted-foreground">· Maker of minipass and minivoip</span>
			</figcaption>
		</figure>
	</section>
}

templ howItWorks() {
	<section id="steps" class="scroll-mt-14 px-4 py-20 sm:px-6 sm:py-[120px]">
		<div class="mx-auto max-w-[1080px]">
			@sectionHead("Ready in three steps", "")
			<ol class="mt-12 grid gap-9 sm:mt-16 md:grid-cols-3 md:gap-12">
				for i, s := range steps {
					<li class="border-t pt-7">
						<h3 class="text-[1.375rem] font-semibold tracking-[-0.02em]"><span class="mr-2.5 text-muted-foreground tabular-nums">{ stepNumber(i) }</span>{ s.Title }</h3>
						<p class="mt-2 text-[17px]/[1.5] text-muted-foreground">{ s.Text }</p>
					</li>
				}
			</ol>
		</div>
	</section>
}

func stepNumber(i int) string {
	return []string{"1", "2", "3"}[i]
}

templ faqList() {
	<section id="faq" class="scroll-mt-14 px-4 pb-20 sm:px-6 sm:pb-[120px]">
		<div class="mx-auto max-w-[760px]">
			@sectionHead("Questions", "")
			<div class="mt-10 divide-y border-y sm:mt-14">
				for _, f := range faqs {
					<details class="group">
						<summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-4 text-[17px] font-medium [&::-webkit-details-marker]:hidden">
							{ f.Q }
							@icon.Plus(icon.Props{Class: "size-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-45"})
						</summary>
						<p class="max-w-[34rem] pb-6 text-[17px]/[1.55] text-muted-foreground">{ f.A }</p>
					</details>
				}
			</div>
		</div>
	</section>
}

// finalCall is the last call to action, with the footer inside the same
// ink band: the page's one dark moment.
templ finalCall(callLine string) {
	<footer class="lp-ink">
		<div class="mx-auto flex max-w-[1080px] flex-col items-center px-4 py-20 text-center sm:px-6 sm:py-28">
			<h2 class="text-[2.25rem] leading-[1.06] font-semibold tracking-[-0.03em] text-balance sm:text-[3.5rem]">Put a Call button on your website.</h2>
			<p class="mt-5 text-lg text-[var(--ink-muted)]">Free while in beta. Start with Basic, move to Premium when it's ready.</p>
			<div class="mt-9 flex flex-col items-center gap-3 sm:flex-row sm:gap-7">
				<a href="/signup" class="flex h-12 items-center justify-center rounded-full bg-[var(--ink-fg)] px-6 text-[17px] font-medium text-[var(--ink-bg)] transition-opacity hover:opacity-90">Get my free line</a>
				if callLine != "" {
					<a href={ templ.SafeURL("/call/" + callLine) } target="_blank" class="inline-flex min-h-12 items-center gap-1 px-2 text-[17px] font-medium underline-offset-4 hover:underline">
						Call us now
						@icon.ChevronRight(icon.Props{Class: "size-4"})
					</a>
				}
			</div>
		</div>
		<div class="mx-auto max-w-[1080px] px-4 sm:px-6">
			<div class="flex flex-col items-center justify-between gap-2 border-t border-[var(--ink-rule)] py-6 text-[13px] text-[var(--ink-muted)] sm:flex-row">
				<div class="flex flex-col items-center gap-1 sm:flex-row sm:gap-3">
					<a href="/" class="flex min-h-11 shrink-0 items-center" aria-label="minivoip home">
						<img src="/assets/brand/logo-minivoip-dark.svg" alt="minivoip" width="132" height="24" class="h-5 w-auto"/>
					</a>
					<span>Part of the mini family, with minipass and minicrm.</span>
				</div>
				<div class="flex items-center gap-5">
					<a href="/download/minivoip.apk" class="flex min-h-11 items-center underline-offset-4 hover:text-[var(--ink-fg)] hover:underline">Get the Android app</a>
					<a href="mailto:kdresdell@minipass.me" class="flex min-h-11 items-center underline-offset-4 hover:text-[var(--ink-fg)] hover:underline">kdresdell@minipass.me</a>
				</div>
			</div>
		</div>
	</footer>
}
