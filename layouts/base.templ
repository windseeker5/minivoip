package layouts

import "minivoip/components"

templ Base(title, description string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="color-scheme" content="light dark"/>
			<link rel="icon" type="image/png" href="/assets/brand/icon.png"/>
			<title>{ title }</title>
			if description != "" {
				<meta name="description" content={ description }/>
			}
			// Set the theme before the first paint: the saved choice, otherwise the
			// system setting. The toggle in the nav writes the same key.
			<script>
				(function () {
					try {
						var t = localStorage.getItem("theme");
						var dark = t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
						document.documentElement.classList.toggle("dark", dark);
					} catch (e) {}
				})();
			</script>
			<link rel="stylesheet" href="/assets/css/output.css"/>
			// htmx is the stack's swap layer: blocks like dashboard-01 drive
			// their partial updates (pagination, lazy drawers) through hx-*
			// attributes against templ fragments. Swap in your own layer
			// (Datastar etc.) by translating those attributes.
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0-beta6/dist/htmx.min.js"></script>
			@components.Scripts()
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
