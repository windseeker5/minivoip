package pages

import (
	"minivoip/components/button"
	"minivoip/components/icon"
	"minivoip/layouts"
	"minivoip/lines"
)

// The words come from docs/landing-copy.md; change them there first.

// stage is one step of "the call grows": what the visitor does, what
// minivoip does for it, and the plan that has it.
type stage struct {
	Title string
	Text  string
	Plan  string
	Soon  bool
}

var stages = []stage{
	{"They ask.", "Your menu answers the easy questions. Hours, prices, directions, or a link to the right page of your site. In your own voice.", "Basic", false},
	{"They talk.", "A real customer reaches you. Your phone or computer rings. Busy? They leave a voicemail.", "Basic", false},
	{"They see.", "Turn on video, share your screen or open the whiteboard. The demo happens while they're still interested.", "Premium · coming soon", true},
}

type plan struct {
	Name    string
	Price   string
	Line    string
	Items   []string
	Premium bool
}

var plans = []plan{
	{"Basic", "$2", "Your website answers the phone for you.", []string{
		"Call button, call link and QR code",
		"Voice menu in your own voice",
		"Sends callers to the right page of your site",
		"Rings your phone and your computer",
		"Voicemail with an alert",
	}, false},
	{"Premium", "$5", "From a question to a live demo, in one click.", []string{
		"Everything in Basic",
		"AI front desk that answers from your FAQ",
		"Video and screen sharing",
		"Whiteboard to draw together",
		"A meeting room for your team, no time limit",
	}, true},
}

type step struct {
	Title string
	Text  string
}

var steps = []step{
	{"Record your menu", "Say hello and set the choices, right from your browser."},
	{"Get the app", "The Android app rings like a real call. On a computer or an iPhone, use the web app."},
	{"Add the button", "Paste one line on your site, or share your call link and QR code."},
}

type faq struct {
	Q string
	A string
}

var faqs = []faq{
	{"Can people call me from a regular phone?", "Not yet. Calls come from your website, your call link or a QR code. A real phone number is planned as an add-on."},
	{"Will my phone ring like a normal call?", "On Android, yes: the minivoip app rings with your ringtone and shows the call screen, even when your phone is locked. Computers ring while the app is open. On iPhone, for now you get a notification with a sound and answer by tapping it; a ringing iPhone app is next."},
	{"Does the visitor need to install anything?", "No. They click the button and talk from their browser, after allowing the microphone."},
	{"I can't edit my website. Can I still use it?", "Yes. Put your call link on your Google Maps listing, your Facebook page, your email signature, or print it as a QR code for your door."},
}

// Home is the landing page; loggedIn swaps "Log in" for the dashboard link.
// line is minivoip's own line (Ken's): the hero plays its recorded greeting
// and "Call us now" calls it. nil shows an example menu and hides the call
// buttons. site is this site's address, for the code to paste.
templ Home(loggedIn bool, line *lines.Line, site string) {
	@layouts.Base("minivoip: your website answers the phone for you", "minivoip puts a Call button on your website. Your voice menu answers the common questions, and when a visitor wants more, you talk to them and show them your screen, in one click. No phone line, nothing to install.") {
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@400..700&family=Funnel+Sans:wght@400..600&family=JetBrains+Mono:wght@400;600&display=swap"/>
		<div class="lp min-h-screen bg-background text-foreground">
			@siteNav(loggedIn)
			<main>
				@hero(line)
				@phoneRings(line)
				@callGrows()
				@pricing()
				@maker()
				@howItWorks(site)
				@faqList()
			</main>
			@finalCall(line)
		</div>
		<script src="/assets/js/landing.js" defer></script>
	}
}

// brand is the mini-family logo (same bars and wordmark as minipass and
// minicrm), one artwork per theme. Only the height is set.
templ brand() {
	<a href="/" class="flex min-h-11 shrink-0 items-center" aria-label="minivoip home">
		<img src="/assets/brand/logo-minivoip.svg" alt="minivoip" width="132" height="24" class="h-5 w-auto sm:h-[22px] dark:hidden"/>
		<img src="/assets/brand/logo-minivoip-dark.svg" alt="minivoip" width="132" height="24" class="hidden h-5 w-auto sm:h-[22px] dark:block"/>
	</a>
}

templ siteNav(loggedIn bool) {
	<nav class="sticky top-0 z-50 bg-background/95">
		<div class="mx-auto flex h-[72px] max-w-[1280px] items-center justify-between gap-2 px-4 sm:px-8">
			@brand()
			<div class="hidden items-center gap-7 text-[15px] text-muted-foreground md:flex">
				<a href="#how" class="transition-colors hover:text-foreground">How it works</a>
				<a href="#pricing" class="transition-colors hover:text-foreground">Plans</a>
				<a href="#faq" class="transition-colors hover:text-foreground">Questions</a>
			</div>
			<div class="flex items-center gap-1 sm:gap-2">
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Class: "size-11 rounded-full text-muted-foreground", Attributes: templ.Attributes{"data-theme-toggle": "", "aria-label": "Switch light or dark mode"}}) {
					<span class="hidden dark:block">
						@icon.Sun()
					</span>
					<span class="block dark:hidden">
						@icon.Moon()
					</span>
				}
				if loggedIn {
					@button.Button(button.Props{Href: "/dashboard", Size: button.SizeSm, Class: "h-11 rounded-full px-4 text-[15px] font-medium sm:h-10"}) {
						My dashboard
					}
				} else {
					<a href="/login" class="hidden min-h-11 items-center rounded-full px-4 text-[15px] font-medium transition-colors hover:bg-muted sm:flex">Log in</a>
					@button.Button(button.Props{Href: "/signup", Size: button.SizeSm, Class: "h-11 rounded-full px-4 text-[15px] font-medium sm:h-10"}) {
						Get my free line
					}
				}
			</div>
		</div>
	</nav>
}

// hero lets the visitor hear minivoip's own line: the recorded greeting on a
// big voice wave, with the words written underneath.
templ hero(line *lines.Line) {
	<section class="mx-auto max-w-[1280px] px-4 pt-12 text-center sm:px-8 sm:pt-[76px]">
		<h1 class="lp-display mx-auto max-w-[1000px] text-[2.875rem] leading-[1] font-semibold tracking-[-0.035em] text-balance sm:text-7xl lg:text-[5.5rem] lg:leading-[.98]">Your website answers the phone for you.</h1>
		<p class="mx-auto mt-5 max-w-[620px] text-lg/relaxed text-pretty text-muted-foreground sm:mt-6 sm:text-xl/relaxed">Record a short menu in your own voice. Visitors hear it, press a number, and get their answer or your cell.</p>
		@voicePlayer(line)
		<div class="mt-10 flex flex-col items-center justify-center gap-3 sm:mt-12 sm:flex-row">
			@button.Button(button.Props{Href: "/signup", Size: button.SizeLg, Class: "h-[52px] w-full max-w-[320px] rounded-full px-7 text-base font-semibold sm:w-auto"}) {
				Get my free line
			}
			if line != nil {
				<a href={ templ.SafeURL("/call/" + line.Name) } target="_blank" data-call-us class="inline-flex h-[52px] w-full max-w-[320px] items-center justify-center gap-2 rounded-full px-6 sm:w-auto text-base font-semibold shadow-[inset_0_0_0_1px_var(--border)] transition-colors hover:bg-muted">
					@icon.Phone(icon.Props{Class: "size-4"})
					Call us now, it's the real thing
				</a>
			} else {
				<a href="#how" class="inline-flex h-[52px] w-full max-w-[320px] items-center justify-center rounded-full px-6 sm:w-auto text-base font-semibold shadow-[inset_0_0_0_1px_var(--border)] transition-colors hover:bg-muted">See how it works</a>
			}
		</div>
		<p class="mt-4 text-sm text-muted-foreground">Free while in beta · No phone line · Nothing to install</p>
	</section>
}

// voicePlayer is the big wave. With a recorded greeting it plays it
// (landing.js); without one it is a still picture of a voice.
templ voicePlayer(line *lines.Line) {
	{{ l := exampleLine }}
	if line != nil {
		{{ l = *line }}
	}
	<div class="lp-voice mt-12 sm:mt-16" data-voice>
		<div class="flex items-center gap-4 text-left sm:gap-7">
			if line != nil && line.GreetingAudio != "" {
				<button type="button" class="lp-play" data-voice-play aria-label="Play minivoip's greeting">
					<svg class="lp-play-on size-7 sm:size-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
					<svg class="lp-play-off size-7 sm:size-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"></path></svg>
				</button>
				<audio preload="metadata" src={ "/prompt/" + line.GreetingAudio }></audio>
			}
			<div class="min-w-0 flex-1">
				<div class="lp-wave" aria-hidden="true" data-voice-seek?={ line != nil && line.GreetingAudio != "" }>
					for _, b := range voiceWave(120, 29, 0.44) {
						<i class={ templ.KV("on", b.On) } style={ b.style() }></i>
					}
					<span class="lp-head" style="left:44%"><span class="tabular-nums" data-voice-at></span></span>
				</div>
				<p class="mt-3 flex justify-between text-[13px] text-muted-foreground">
					if line != nil && line.GreetingAudio != "" {
						<span>minivoip's own line · the real recording</span>
						<span class="tabular-nums" data-voice-time></span>
					} else {
						<span>Example of a voice menu</span>
					}
				</p>
			</div>
		</div>
		<p class="lp-display lp-words mx-auto mt-10 max-w-[1000px] text-2xl leading-[1.3] font-medium tracking-[-0.02em] text-balance sm:mt-12 sm:text-[2.25rem]" data-voice-text>
			for _, w := range voiceWords(l) {
				<span class={ w.Class }>{ w.Text }</span>
			}
		</p>
	</div>
}

// phoneRings is the other end of the call: the owner's phone ringing, on the
// logo's colours.
templ phoneRings(line *lines.Line) {
	{{ l := exampleLine }}
	if line != nil {
		{{ l = *line }}
	}
	<section class="px-3 pt-24 sm:px-6 sm:pt-32">
		<div class="lp-spectrum mx-auto max-w-[1280px]">
			<div class="relative z-[1] grid items-center gap-10 px-6 py-14 sm:px-12 sm:py-20 lg:grid-cols-2 lg:gap-6 lg:px-16">
				<div class="max-w-[30rem] text-[#0c0c0d]">
					<h2 class="lp-display text-[2.5rem] leading-[1] font-semibold tracking-[-0.04em] text-balance sm:text-6xl">Then your own phone rings.</h2>
					<p class="mt-5 text-lg/relaxed font-medium">You see what they chose before you answer. Busy? They leave a voicemail and you get an alert.</p>
				</div>
				<div class="relative mx-auto h-[600px] w-full max-w-[460px]" aria-hidden="true">
					<div class="lp-phone absolute top-0 right-0 sm:right-6">
						<div class="lp-screen">
							<p class="flex items-center gap-2 text-[13px] text-[#55555b]"><span class="size-2 rounded-full bg-[#1f9d55] shadow-[0_0_0_4px_#dcf2e4]"></span><span>Incoming call · <span class="tabular-nums">0:04</span></span></p>
							<p class="lp-display mt-[22px] text-[30px] leading-[1.06] font-semibold tracking-[-0.03em]">Someone chose <span class="block text-[#c9461a]">“{ ringChoice(l) }”</span></p>
							<p class="mt-3 text-[13.5px]/[1.45] text-[#6b6b70]">A visitor on your website heard your greeting and picked this choice.</p>
							<p class="mt-[18px] rounded-[14px] px-3 py-2.5 text-[12.5px] text-[#6b6b70] shadow-[inset_0_0_0_1px_#e8e8ec]">If nobody answers: <b class="font-semibold text-[#111113]">voicemail in <span class="tabular-nums">0:26</span></b></p>
							<div class="absolute inset-x-[22px] bottom-[30px] flex flex-col gap-2">
								<span class="rounded-[15px] bg-[#157a3f] p-[15px] text-center text-base font-semibold text-white">Answer</span>
								<span class="rounded-[15px] p-3 text-center text-sm font-medium text-[#b4321f] shadow-[inset_0_0_0_1px_#e8e8ec]">Decline</span>
							</div>
						</div>
					</div>
					<div class="lp-toast absolute top-[318px] left-0">
						<span class="grid size-[38px] shrink-0 place-items-center rounded-[11px] bg-[#111113] text-white">
							@icon.Voicemail(icon.Props{Class: "size-[18px]"})
						</span>
						<span class="min-w-0 flex-1 text-[13px]/[1.35] text-[#6b6b70]"><b class="block text-sm font-semibold text-[#111113]">New voicemail</b>From your website · <span class="tabular-nums">0:38</span></span>
						<span class="rounded-full bg-[#f0f0f3] px-3 py-1.5 text-xs font-semibold text-[#111113]">Play</span>
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ sectionHead(title, lead string) {
	<div class="mx-auto max-w-[860px] text-center">
		<h2 class="lp-display text-[2.5rem] leading-[1] font-semibold tracking-[-0.04em] text-balance sm:text-6xl">{ title }</h2>
		if lead != "" {
			<p class="mx-auto mt-5 max-w-[580px] text-lg/relaxed text-pretty text-muted-foreground sm:text-xl/relaxed">{ lead }</p>
		}
	</div>
}

// callGrows tells the story in three steps: answers, then the owner, then
// the owner's screen. The last one is Premium.
templ callGrows() {
	<section id="how" class="scroll-mt-[72px] px-4 pt-24 sm:px-8 sm:pt-32">
		<div class="mx-auto max-w-[1280px]">
			@sectionHead("One click, and the call grows with the question.", "Most visitors only need an answer. Some need you. A few need to see it. minivoip handles all three in the same call.")
			<div class="mt-12 grid gap-10 sm:mt-16 md:grid-cols-3 md:gap-12">
				for _, s := range stages {
					<div class="flex flex-col border-t pt-7">
						<h3 class="lp-display text-[2rem] font-semibold tracking-[-0.03em]">{ s.Title }</h3>
						<p class="mt-3 text-[17px]/[1.55] text-muted-foreground">{ s.Text }</p>
						<p class={ "mt-auto pt-5 text-[13px] font-semibold", templ.KV("text-muted-foreground", s.Soon) }>{ s.Plan }</p>
					</div>
				}
			</div>
		</div>
	</section>
}

templ pricing() {
	<section id="pricing" class="scroll-mt-[72px] px-4 pt-24 sm:px-8 sm:pt-32">
		<div class="mx-auto max-w-[1280px]">
			@sectionHead("Start with Basic. Grow into Premium.", "Free while in beta. No per‑minute charges.")
			<div class="mx-auto mt-12 grid max-w-[920px] gap-4 sm:mt-16 md:grid-cols-2">
				for _, p := range plans {
					@planCard(p)
				}
			</div>
			<p class="mt-8 text-center text-sm text-muted-foreground">Have a promo code? Enter it when you sign up.</p>
		</div>
	</section>
}

templ planCard(p plan) {
	<div class={ "flex flex-col rounded-2xl p-7 sm:p-9", templ.KV("bg-card shadow-[0_0_0_1px_var(--border)]", !p.Premium), templ.KV("bg-muted", p.Premium) }>
		<div class="flex items-baseline justify-between gap-3">
			<h3 class="lp-display text-2xl font-semibold tracking-[-0.02em]">{ p.Name }</h3>
			if p.Premium {
				<span class="rounded-full bg-background px-3 py-1 text-xs font-semibold">Coming soon</span>
			} else {
				<span class="rounded-full bg-muted px-3 py-1 text-xs font-semibold">Free in beta</span>
			}
		</div>
		<p class="mt-6 flex items-baseline gap-2">
			<span class="lp-display text-[3.25rem] leading-none font-semibold tracking-[-0.04em]">{ p.Price }</span>
			<span class="text-muted-foreground">/ month after beta, planned</span>
		</p>
		<p class="mt-3 text-[17px] font-medium">{ p.Line }</p>
		<ul class="mt-7 mb-8 flex flex-col text-[15px]">
			for _, item := range p.Items {
				<li class="flex items-start gap-3 border-t py-3">
					@icon.Check(icon.Props{Class: "mt-0.5 size-4 shrink-0"})
					{ item }
				</li>
			}
		</ul>
		if p.Premium {
			@button.Button(button.Props{Href: "mailto:kdresdell@minipass.me?subject=minivoip%20Premium", Variant: button.VariantOutline, Size: button.SizeLg, Class: "mt-auto h-12 w-full rounded-full bg-background text-[15px] font-semibold"}) {
				Tell me when it's ready
			}
		} else {
			@button.Button(button.Props{Href: "/signup", Size: button.SizeLg, Class: "mt-auto h-12 w-full rounded-full text-[15px] font-semibold"}) {
				Get my free line
			}
		}
	</div>
}

// maker is Ken's own reason for minivoip: he uses it on his businesses first.
templ maker() {
	<section class="px-4 pt-24 sm:px-8 sm:pt-32">
		<figure class="mx-auto max-w-[940px] text-center">
			<blockquote class="lp-display text-[1.75rem] leading-[1.25] font-medium tracking-[-0.025em] text-balance sm:text-[2.75rem] sm:leading-[1.18]">
				“I built minivoip for my own businesses first. A visitor on my site asks a question, and a minute later I'm showing them the product.”
			</blockquote>
			<figcaption class="mt-7 text-[15px]"><span class="font-semibold">Ken Dresdell</span> <span class="text-muted-foreground">· Maker of minipass and minivoip</span></figcaption>
		</figure>
	</section>
}

// howItWorks is the setup in three steps, with the one line an owner pastes
// on their site and the button it makes.
templ howItWorks(site string) {
	<section id="steps" class="scroll-mt-[72px] px-4 pt-24 sm:px-8 sm:pt-32">
		<div class="mx-auto max-w-[1280px]">
			<h2 class="lp-display text-[2.5rem] leading-[1] font-semibold tracking-[-0.04em] text-balance sm:text-6xl">Ready in three steps</h2>
			<div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-20">
				<ol class="flex flex-col">
					for i, s := range steps {
						<li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-2 border-t py-6 first:pt-6">
							<span class="lp-display text-[1.75rem] leading-none font-semibold text-muted-foreground tabular-nums">{ stepNumber(i) }</span>
							<div>
								<h3 class="lp-display text-[1.375rem] leading-tight font-semibold tracking-[-0.02em]">{ s.Title }</h3>
								<p class="mt-1.5 text-[17px]/[1.55] text-muted-foreground">{ s.Text }</p>
							</div>
						</li>
					}
				</ol>
				<div class="min-w-0 border-t pt-6">
					<div class="flex items-center justify-between gap-3">
						<p class="text-[15px] font-semibold">Paste this on your site</p>
						<button type="button" class="min-h-11 rounded-full px-4 text-sm font-semibold shadow-[inset_0_0_0_1px_var(--border)] transition-colors hover:bg-muted" data-copy-code>Copy</button>
					</div>
					<pre class="lp-code" data-code><span class="t">&lt;a</span> <span class="a">href</span>=<span class="s">"{ site }/call/<wbr/><b>your-business</b>"</span><span class="t">&gt;</span>Call us<span class="t">&lt;/a&gt;</span></pre>
					<div class="mt-6 flex flex-col gap-4 rounded-2xl bg-muted p-6 sm:flex-row sm:items-center sm:p-8">
						<span class="inline-flex shrink-0 items-center gap-2.5 self-start rounded-full bg-[#f46422] py-3.5 pr-6 pl-5 text-base font-semibold text-[#111113]" aria-hidden="true">
							@icon.Phone(icon.Props{Class: "size-[18px]"})
							Call us
						</span>
						<p class="text-[15px]/[1.5] text-muted-foreground">That's the button it makes. No website? Share the link, or print it as a QR code for your door.</p>
					</div>
				</div>
			</div>
		</div>
	</section>
}

func stepNumber(i int) string {
	return []string{"1", "2", "3"}[i]
}

templ faqList() {
	<section id="faq" class="scroll-mt-[72px] px-4 py-24 sm:px-8 sm:py-32">
		<div class="mx-auto max-w-[780px]">
			@sectionHead("Questions", "")
			<div class="mt-10 divide-y border-y sm:mt-14">
				for _, f := range faqs {
					<details class="group">
						<summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-4 text-lg font-medium [&::-webkit-details-marker]:hidden">
							{ f.Q }
							@icon.Plus(icon.Props{Class: "size-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-45"})
						</summary>
						<p class="max-w-[34rem] pb-6 text-[17px]/[1.55] text-muted-foreground">{ f.A }</p>
					</details>
				}
			</div>
		</div>
	</section>
}

// finalCall is the last call to action, with the footer inside the same
// ink band: the page's one dark moment.
templ finalCall(line *lines.Line) {
	<footer class="lp-ink">
		<div class="mx-auto flex max-w-[1280px] flex-col items-center px-4 py-20 text-center sm:px-8 sm:py-28">
			<h2 class="lp-display text-[2.5rem] leading-[1] font-semibold tracking-[-0.04em] text-balance sm:text-6xl">Put a Call button on your website.</h2>
			<p class="mt-5 text-lg text-[var(--ink-muted)]">Free while in beta. Start with Basic, move to Premium when it's ready.</p>
			<div class="mt-9 flex flex-col items-center gap-3 sm:flex-row">
				<a href="/signup" class="flex h-[52px] w-full max-w-[320px] items-center justify-center rounded-full bg-[var(--ink-fg)] px-7 sm:w-auto text-base font-semibold text-[var(--ink-bg)] transition-opacity hover:opacity-90">Get my free line</a>
				if line != nil {
					<a href={ templ.SafeURL("/call/" + line.Name) } target="_blank" class="inline-flex h-[52px] w-full max-w-[320px] items-center justify-center gap-2 rounded-full px-6 text-base font-semibold shadow-[inset_0_0_0_1px_var(--ink-rule)] sm:w-auto transition-colors hover:bg-white/10">
						@icon.Phone(icon.Props{Class: "size-4"})
						Call us now
					</a>
				}
			</div>
		</div>
		<div class="mx-auto max-w-[1280px] px-4 sm:px-8">
			<div class="flex flex-col items-center justify-between gap-2 border-t border-[var(--ink-rule)] py-6 text-[13px] text-[var(--ink-muted)] sm:flex-row">
				<div class="flex flex-col items-center gap-1 sm:flex-row sm:gap-3">
					<a href="/" class="flex min-h-11 shrink-0 items-center" aria-label="minivoip home">
						<img src="/assets/brand/logo-minivoip-dark.svg" alt="minivoip" width="132" height="24" class="h-5 w-auto"/>
					</a>
					<span>Part of the mini family, with minipass and minicrm.</span>
				</div>
				<div class="flex flex-wrap items-center justify-center gap-x-5">
